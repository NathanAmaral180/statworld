---
// Moldura comum de todas as páginas: <head>, tema e cabeçalho.
import '../estilos/global.css';
import '../estilos/cores-produtos.css';
import '../estilos/cores-setores.css';
import '../estilos/cores-servicos.css';
import Cabecalho from '../componentes/Cabecalho.astro';
import EspacoAnuncio from '../componentes/EspacoAnuncio.astro';
import AvisoCookies from '../componentes/AvisoCookies.astro';
import anuncios from '../config/anuncios.json';
import site from '../config/site.json';

// semAnuncios: páginas sem espaço de anúncio (ex.: política de privacidade).
interface Props { titulo?: string; descricao?: string; temaAtual?: string; naoIndexar?: boolean; semAnuncios?: boolean }
const { titulo, descricao = site.slogan, temaAtual, naoIndexar = false, semAnuncios = false } = Astro.props;
// Colunas laterais de anúncio: só aparecem em telas bem largas, fora da área do conteúdo.
const telaMinima = anuncios.posicoes.lateral.telaMinima;
const cssLaterais = `.anuncios-laterais{display:none}@media (min-width:${telaMinima}px){.anuncios-laterais{display:block}}`;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · ${site.slogan}`;
---
<!doctype html>
<html lang={site.idiomaPadrao}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {naoIndexar && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Aplica o tema antes de desenhar a página (evita "piscar").
      // Usa a escolha salva; se não houver, segue o tema do computador.
      (function () {
        var t = null;
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <Cabecalho temaAtual={temaAtual} />
    <main>
      <slot />
    </main>
    {!semAnuncios && (
      <div class="anuncios-laterais">
        <style is:inline set:html={cssLaterais}></style>
        <div class="lateral esquerda"><EspacoAnuncio posicao="lateral" /></div>
        <div class="lateral direita"><EspacoAnuncio posicao="lateral" /></div>
      </div>
    )}
    <footer class="rodape-site">
      <div class="conteudo">
        <span>{site.nome}</span>
        <a href="/privacidade">Privacidade</a>
        <a href="/privacidade#cookies" data-abrir-cookies>Preferências de cookies</a>
      </div>
    </footer>
    <AvisoCookies />
    <script is:inline>
      // Contador de visitas anônimo do próprio StatWorld (servidor/index.js): sem cookies e sem guardar nada no navegador.
      // Manda a página e de onde a pessoa veio; ao sair, manda só quanto tempo ficou (contando só o tempo com a aba à vista).
      (function () {
        if (!navigator.sendBeacon || /^\/admin/.test(location.pathname) || /^(localhost|127\.)/.test(location.hostname)) return;
        var id = Math.random().toString(36).slice(2, 12) + Date.now().toString(36);
        var visivel = 0, desde = document.visibilityState === 'visible' ? Date.now() : 0, enviado = false;
        var mandar = function (d) { try { navigator.sendBeacon('/api/visita', new Blob([JSON.stringify(d)], { type: 'application/json' })); } catch (e) {} };
        mandar({ id: id, caminho: location.pathname, origem: document.referrer });
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible') { desde = Date.now(); return; }
          if (desde) visivel += Date.now() - desde;
          desde = 0;
          mandar({ id: id, tipo: 'tempo', segundos: Math.round(visivel / 1000) });
          enviado = true;
        });
        addEventListener('pagehide', function () {
          if (enviado && !desde) return;
          if (desde) visivel += Date.now() - desde;
          desde = 0;
          mandar({ id: id, tipo: 'tempo', segundos: Math.round(visivel / 1000) });
        });
      })();
    </script>
  </body>
</html>

<style>
  /* Colunas laterais de anúncio: presas na tela, ao lado (fora) da área de 1440px do conteúdo. */
  .lateral { position: fixed; top: 140px; z-index: 1; }
  .esquerda { right: calc(50% + 720px + 24px); }
  .direita { left: calc(50% + 720px + 24px); }
  .rodape-site { border-top: 1px solid var(--line); margin-top: 64px; }
  .rodape-site .conteudo { display: flex; gap: 24px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 32px; font-size: 13px; color: var(--faint); }
  .rodape-site a { color: var(--sub); text-decoration: none; }
  .rodape-site a:hover { color: var(--ink); text-decoration: underline; }
</style>
