---
// Página de uma trilha de "Fios" (ex.: /fios/telegrafo-ao-smartphone). Cada trilha é um arquivo em dados/fios/.
import Base from '../../layouts/Base.astro';
import Fios from '../../componentes/Fios.astro';
import { carregarDados, listarDados } from '../../lib/dados';
import { carregarTextos } from '../../lib/dados';
import site from '../../config/site.json';

export function getStaticPaths() {
  // o universo (dados/fios/universo.json e fotos.json) tem página própria (src/pages/fios/universo.astro)
  return listarDados('fios', '').filter((nome) => !['universo', 'fotos'].includes(nome)).map((nome) => ({ params: { trilha: nome } }));
}
const { trilha: id } = Astro.params;
const trilha = carregarDados<any>('fios', id!);
const textos = carregarTextos(site.idiomaPadrao);
---
<Base titulo={`${trilha.titulo} · Fios`} descricao={trilha.descricao}>
  <section class="conteudo pagina">
    <p class="trilha-topo"><a href="/fios">Fios</a> / {trilha.titulo}</p>
    <h1>{trilha.titulo}</h1>
    <p class="desc">{trilha.descricao} <span>Puxe um fio: toque num item e siga para onde ele leva.</span></p>
    <Fios trilha={trilha} textos={textos} />
  </section>
</Base>

<style>
  .pagina { padding-top: 32px; padding-bottom: 64px; }
  .trilha-topo { margin: 0 0 8px; color: var(--sub); font-size: 15px; }
  .trilha-topo a { color: inherit; }
  h1 { margin: 0 0 8px; font-size: clamp(28px, 4vw, 48px); line-height: 1.05; letter-spacing: -0.02em; }
  .desc { margin: 0 0 20px; color: var(--sub); font-size: 17px; line-height: 1.5; max-width: 72ch; }
  .desc span { color: var(--ink); }
  @media (max-width: 640px) {
    .pagina { padding-top: 16px; }
    .desc { font-size: 15px; }
  }
</style>
