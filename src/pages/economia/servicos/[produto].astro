---
// Página de uma atividade de serviços (Brasil). Uma página por atividade; o conteúdo vem do molde PaginaProdutoAgro.
import PaginaProdutoAgro from '../../../componentes/PaginaProdutoAgro.astro';
import paisCfg from '../../../config/paises/brasil.json';
import { carregarAgro } from '../../../lib/agro';

export function getStaticPaths() {
  return carregarAgro(paisCfg, 'estado', 'servicos').todos.map((p) => ({ params: { produto: p.id } }));
}
---
<PaginaProdutoAgro pais={paisCfg} produtoId={Astro.params.produto!} temaId="servicos" />
