---
// Economia · Agro: produto líder (tudo / lavouras / pecuária) e quanto cada estado produz.
// Números: dados/agro/. Configuração: src/config/temas/agro-estados.json.
import Base from '../../../layouts/Base.astro';
import Abas from '../../../componentes/Abas.astro';
import MapaRanking from '../../../componentes/mapa-ranking/MapaRanking.astro';
import { construirVisaoLider, construirVisaoProduto } from '../../../componentes/mapa-ranking/construir-producao';
import { preencher } from '../../../componentes/mapa-ranking/visao';
import pais from '../../../config/paises/brasil.json';
import site from '../../../config/site.json';
import temaBase from '../../../config/temas/agro-estados.json';
import iconesAgro from '../../../config/icones/agro.json';
import { contextoDoPais } from '../../../lib/contexto';
import { carregarAgro } from '../../../lib/agro';
const tema = { ...temaBase, icones: iconesAgro };

const NIVEL = 'estado';
const { geo, ctx, unidades, mapa } = contextoDoPais(pais, NIVEL);
const { todos, porFiltro } = carregarAgro(pais, NIVEL, tema);

const padrao = todos.find((p) => p.id === tema.produtoPadrao) ?? todos[0];
const visoes: Record<string, any> = {
  [`lista:${padrao.id}`]: construirVisaoProduto(padrao.id, unidades, porFiltro.tudo, padrao, 'valor', tema, ctx, true),
};
for (const f of tema.filtros) {
  visoes[`lider-${f.id}`] = construirVisaoLider(`lider-${f.id}`, unidades, porFiltro[f.id], tema, ctx, f.grupoTexto);
}
const opcoes = [
  {
    id: 'lider',
    rotulo: tema.opcoes.lider,
    filtros: { rotulo: tema.opcoes.mostrar, padrao: tema.filtros[0].id, itens: tema.filtros.map((f) => ({ id: f.id, rotulo: f.rotulo, visao: `lider-${f.id}` })) },
  },
  {
    id: 'quanto',
    rotulo: tema.opcoes.quanto,
    lista: {
      rotulo: ctx.textos.escolhaProduto,
      padrao: padrao.id,
      itens: ['lavouras', 'pecuaria'].flatMap((g) =>
        todos.filter((p) => p.grupo === g).map((p) => ({
          id: p.id, rotulo: p.nome, grupo: tema.grupos[g as keyof typeof tema.grupos], url: preencher(tema.urlDadosProduto, { produto: p.id }),
        }))
      ),
    },
  },
];

const titulo = preencher(tema.titulo, { pais: pais.nome });
const trilha = tema.trilha.map((t) => preencher(t, { pais: pais.nome }));
---
<Base titulo={`${trilha.at(-1)} · ${titulo}`} temaAtual="economia">
  <section class="conteudo pagina">
    <p class="trilha">{trilha.join(' / ')}</p>
    <h1>{titulo}</h1>
    <Abas itens={site.subtemas.economia} atual="agro" rotulo="Economia" emBreve={site.textos.emBreve} />
    <MapaRanking geo={geo} mapa={mapa} ctx={ctx} opcoes={opcoes} opcaoInicial="lider" visoes={visoes} />
  </section>
</Base>

<style>
  .pagina { padding-top: 40px; padding-bottom: 80px; }
  .trilha { margin: 0 0 12px; color: var(--sub); font-size: 17px; }
  h1 { margin: 0 0 24px; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
</style>
