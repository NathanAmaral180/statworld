---
// Página "não encontrada" (erro 404): aparece quando alguém abre um endereço que não existe.
import Base from '../layouts/Base.astro';
import { abasDe } from '../lib/catalogo';
import pais from '../config/paises/brasil.json';
const abas = abasDe('economia', pais).filter((a: any) => a.ativo);
---
<Base titulo="Página não encontrada" descricao="O endereço procurado não existe no StatWorld." naoIndexar semAnuncios>
  <section class="conteudo erro">
    <p class="codigo">Erro 404</p>
    <h1>Esta página não existe</h1>
    <p class="texto">O endereço pode ter sido digitado errado ou a página mudou de lugar. Tente um destes caminhos:</p>
    <ul>
      <li><a href="/">Página inicial</a></li>
      {abas.map((a: any) => <li><a href={a.href}>Economia · {a.nome}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .erro { padding-top: 56px; padding-bottom: 40px; max-width: 760px; }
  .codigo { margin: 0 0 8px; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); font-weight: 600; }
  h1 { margin: 0 0 12px; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
  .texto { margin: 0 0 20px; color: var(--sub); font-size: 17px; line-height: 1.5; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { color: var(--accent); font-size: 17px; }
</style>
