---
// Página de um setor da indústria (Estados Unidos). Mesmo molde do Brasil (PaginaProdutoAgro).
import PaginaProdutoAgro from '../../../../componentes/PaginaProdutoAgro.astro';
import paisCfg from '../../../../config/paises/estados-unidos.json';
import { carregarAgro } from '../../../../lib/agro';

export function getStaticPaths() {
  return carregarAgro(paisCfg, 'estado', 'industria').todos.map((p) => ({ params: { produto: p.id } }));
}
---
<PaginaProdutoAgro pais={paisCfg} produtoId={Astro.params.produto!} temaId="industria" />
