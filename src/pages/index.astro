---
// Página inicial (endereço "/"). Ainda sem dados: só a fundação.
import Base from '../layouts/Base.astro';
import site from '../config/site.json';
---
<Base temaAtual="">
  <section class="conteudo abertura">
    <p class="trilha">Início</p>
    <h1>{site.slogan}</h1>
    <p class="sub">
      Dados públicos, com fonte e data em cada número. Começamos por <a href="/economia">Economia</a>.
    </p>
  </section>
</Base>

<style>
  .abertura { padding-top: 48px; padding-bottom: 80px; }
  .trilha { margin: 0 0 16px; color: var(--sub); font-size: 17px; }
  h1 { margin: 0 0 20px; font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; max-width: 18ch; }
  .sub { margin: 0; color: var(--sub); font-size: 19px; line-height: 1.5; max-width: 52ch; }
</style>
