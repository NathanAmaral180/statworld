---
// Página inicial. Visual: design da rodada 3 (design/rodada-3-lugares/), com as correções.
// Todos os números vêm de dados/ (mapa-múndi, faixa "Agora", números do mundo).
import Base from '../layouts/Base.astro';
import site from '../config/site.json';
import { temas as todosTemas, temasPorGrupo } from '../lib/catalogo';
import pais from '../config/paises/brasil.json';
import { carregarDados, carregarTextos } from '../lib/dados';
import { carregarAgro } from '../lib/agro';
import { formatar, formatarEmPartes, type Contexto, type Fonte } from '../componentes/mapa-ranking/visao';

const ctx: Contexto = { idioma: site.idiomaPadrao, moeda: pais.moeda.codigo, textos: carregarTextos(site.idiomaPadrao), nivelSingular: 'país', nivelPlural: 'países' };
const ctxUsd: Contexto = { ...ctx, moeda: 'USD' };
const mundo = carregarDados<any>('geo', 'mundo-paises');
const agora = carregarDados<any>('agora', 'brasil');
const temasMundo = carregarDados<any>('mundo', 'temas');
const economia = carregarDados<any>('economia', 'brasil-estados');
const lavouras = carregarDados<any>('agro', 'brasil-estados-lavouras');
const pecuaria = carregarDados<any>('agro', 'brasil-estados-pecuaria');
const industria = carregarDados<any>('industria', 'brasil-estados');
const servicos = carregarDados<any>('servicos', 'brasil-estados');
const trabalho = carregarDados<any>('trabalho', 'brasil-estados');
const trabalhoSeries = carregarDados<any>('trabalho', 'brasil-series');
const caged = carregarDados<any>('trabalho', 'brasil-caged');
const precosEstados = carregarDados<any>('precos', 'brasil-estados');
const precosIpca = carregarDados<any>('precos', 'brasil-ipca');
const precosSm = carregarDados<any>('precos', 'brasil-sm-cestas');
const comercio = carregarDados<any>('comercio', 'brasil-estados');
const dinheiro = carregarDados<any>('dinheiro', 'brasil-series');
const contasR100 = carregarDados<any>('contas-publicas', 'brasil-r100');
const contasDivida = carregarDados<any>('contas-publicas', 'brasil-divida');
const contasCofog = carregarDados<any>('contas-publicas', 'brasil-cofog');

// ---------- datas ----------
const dataLonga = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(ctx.idioma, { day: 'numeric', month: 'short', year: 'numeric' }).replace(/\./g, '').replace(/ de /g, ' ');
const mesAno = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(ctx.idioma, { month: 'short', year: 'numeric' }).replace(/\./g, '').replace(/ de /g, ' ');

// ---------- mapa-múndi ----------
const disponiveis = new Map(site.paises.filter((p) => p.disponivel).map((p) => [p.codigo, p]));

// ---------- faixa "Agora" ----------
const kpis = agora.indicadores.map((i: any) => {
  const partes = formatarEmPartes(i.valor, { formato: i.formato, casas: i.casas }, ctx);
  const v = i.variacao?.valor;
  let dir = 'z', seta = '=', texto = '';
  if (v !== null && v !== undefined) {
    const r = Math.round(v * 100) / 100;
    dir = r > 0 ? 'u' : r < 0 ? 'n' : 'z';
    seta = r > 0 ? '▲' : r < 0 ? '▼' : '=';
    const num = new Intl.NumberFormat(ctx.idioma, { minimumFractionDigits: 2, maximumFractionDigits: 2, signDisplay: 'exceptZero' }).format(r);
    texto = (i.variacao.tipo === 'percentual' ? `${num}%` : `${num} p.p.`).replace('-', '−');
  }
  const comparacao = i.variacao?.mantida
    ? `mudou em ${dataLonga(i.variacao.desde)}`
    : i.periodoMensal ? `sobre ${mesAno(i.variacao.desde)}` : `sobre ${dataLonga(i.variacao.desde)}`;
  const quando = i.periodoMensal ? mesAno(i.data) : i.variacao?.mantida ? `vigente em ${dataLonga(i.data)}` : dataLonga(i.data);
  return { ...i, partes, dir, seta, texto, comparacao, quando, fonteCurta: i.fontes[0].nome };
});

// ---------- temas ----------
const porTema = Object.fromEntries(temasMundo.temas.map((t: any) => [t.tema, t]));
function numeroTema(t: any) {
  if (!t || t.valor === null) return { numero: ctx.textos.semDado, unidade: '' };
  if (t.unidade === 'moeda-usd') {
    const p = formatarEmPartes(t.valor, { formato: 'moeda', casas: 1, compacto: true }, ctxUsd);
    return { numero: p.numero, unidade: `${p.depois} ${p.antes}`.trim() };
  }
  if (t.unidade === 'pessoas') {
    const p = formatarEmPartes(t.valor, { formato: 'numero', casas: 1, compacto: true }, ctx);
    return { numero: p.numero, unidade: p.depois };
  }
  if (t.unidade === '%') return { numero: formatar(t.valor, { formato: 'numero', casas: 1 }, ctx), unidade: '%' };
  return { numero: formatar(t.valor, { formato: 'numero', casas: 1 }, ctx), unidade: t.unidade };
}
// Cartões de tema: os temas do menu do topo, com um número do mundo (cadastro: numeroDoMundo).
const temas = todosTemas.filter((t) => t.cabecalho).map((t) => {
  const d = porTema[t.numeroDoMundo ?? ''];
  const f: Fonte | undefined = d?.fontes?.[0];
  return {
    ...t,
    ...numeroTema(d),
    rotulo: d ? `${d.rotulo}${d.periodo ? ` em ${d.periodo}` : ''}` : '',
    fonte: f ? `${f.nome}, WDI${f.dataAtualizacao ? ` · atualizado em ${dataLonga(f.dataAtualizacao)}` : ''}` : '',
    origem: d?.origem,
    nome: t.nomeCurto ?? t.nome,
    ativo: t.situacao === 'no-ar' && !!t.href,
    descricao: (t as any).resumo ?? '',
  };
});

// ---------- histórias (só o que existe no site) ----------
const fonteCurta = (f: Fonte) => `${f.nome}, ${f.publicacao.replace(/ \(.*\)$/, '').replace(/, versão.*$/, '')}`;
// Textos com números: todos vêm dos arquivos de dados (nada digitado aqui).
const comDado = (v: Record<string, any>) => Object.values(v).filter((x) => x != null).length;
const nProdutosAgro = carregarAgro(pais, 'estado').todos.length;
const grupo = (lista: any[], id: string) => lista.find((x) => x.id === id);
const anoIni = (pontos: any[]) => pontos[0]?.nome.match(/\d{4}/)?.[0] ?? '';
// Trilha de "Fios" em destaque (dados/fios/): título, descrição e quem publicou as fontes vêm do arquivo.
const fio = carregarDados<any>('fios', 'telegrafo-ao-smartphone');
const fontesFio = [...new Set(fio.nos.flatMap((n: any) => n.fontes.map((f: any) => f.nome.split(',')[0].replace(' (inglês)', '').replace(/^Prêmio Nobel.*/, 'Prêmio Nobel'))))] as string[];
const historias = [
  {
    k: 'Fios · História · Novo', lead: true, href: `/fios/${fio.id}`,
    t: fio.titulo,
    p: `${fio.descricao} São ${fio.nos.length} criações e fatos ligados entre si, de ${Math.min(...fio.nos.map((n: any) => n.ano))} a ${Math.max(...fio.nos.map((n: any) => n.ano))}.`,
    m: fontesFio.slice(0, 3),
  },
  {
    k: 'Economia · Brasil · Mapa', href: '/economia/agro',
    t: 'O que cada estado mais produz no agro',
    p: `O produto líder de cada um dos ${comDado(economia.indicadores['peso-pib'].valores)} estados, com lavouras e pecuária, e quanto cada estado produz de ${nProdutosAgro} produtos.`,
    m: [...lavouras.fontes, ...pecuaria.fontes].map(fonteCurta).filter((x, i, a) => a.indexOf(x) === i).slice(0, 3),
  },
  {
    k: 'Economia · Brasil · Contas públicas', href: '/economia/contas-publicas',
    t: 'De onde vem e para onde vai cada R$ 100 do governo',
    p: `Em ${contasR100.periodo}, de cada R$ 100 gastos pelo governo federal, R$ ${grupo(contasR100.saidas, 'juros').de100} foram para os juros da dívida e R$ ${grupo(contasR100.entradas, 'nova-divida').de100} vieram de nova dívida.`,
    m: [fonteCurta(contasR100.fontes[0])],
  },
  {
    k: 'Economia · Brasil · Trabalho', href: '/economia/trabalho',
    t: 'Desemprego e renda, estado por estado',
    p: `Taxa de desemprego e renda média dos ${comDado(trabalho.indicadores.desemprego.valores)} estados (${trabalho.periodo}) e o Brasil mês a mês desde ${anoIni(trabalhoSeries.series.desemprego.pontos)}.`,
    m: [fonteCurta(trabalho.indicadores.desemprego.fontes[0])],
  },
  {
    k: 'Economia · Brasil · Guia', href: '/economia',
    t: 'Onde está o PIB do Brasil, estado por estado',
    p: `Peso no PIB, PIB por pessoa e crescimento dos ${comDado(economia.indicadores['peso-pib'].valores)} estados.`,
    m: [fonteCurta(economia.indicadores.crescimento.fontes[0])],
  },
  {
    k: 'Economia · Brasil · Preços', href: '/economia/precos',
    t: 'Quanto custa a cesta básica em cada capital',
    p: `O preço da cesta nas ${comDado(precosEstados.indicadores.cesta.valores)} capitais (${precosEstados.periodo}) e quantas cestas o salário mínimo compra desde ${precosSm.serie.pontos[0].periodo}.`,
    m: [fonteCurta(precosEstados.indicadores.cesta.fontes[0])],
  },
  {
    k: 'Economia · Brasil · Comércio exterior', href: '/economia/comercio-exterior',
    t: 'O que o Brasil vende e para quem',
    p: `Quanto cada estado exportou em ${comercio.periodo}, os dez principais produtos e países compradores, e a balança do ano.`,
    m: [fonteCurta(comercio.indicadores.exportacoes.fontes[0])],
  },
];

// ---------- fontes usadas (lidas dos próprios dados) ----------
const todasFontes: Fonte[] = [
  ...Object.values(economia.indicadores).flatMap((i: any) => i.fontes),
  ...Object.values(trabalho.indicadores).flatMap((i: any) => i.fontes), ...Object.values(trabalhoSeries.series).flatMap((i: any) => i.fontes), ...Object.values(caged.indicadores).flatMap((i: any) => i.fontes),
  ...Object.values(precosEstados.indicadores).flatMap((i: any) => i.fontes), ...precosIpca.serie.fontes, ...precosSm.serie.fontes, ...comercio.indicadores.exportacoes.fontes, ...dinheiro.series.flatMap((x: any) => x.fontes), ...contasR100.fontes, ...contasDivida.serie.fontes, ...contasCofog.fontes,
  ...lavouras.fontes, ...pecuaria.fontes, ...industria.fontes, ...servicos.fontes, ...agora.indicadores.flatMap((i: any) => i.fontes),
  ...temasMundo.temas.flatMap((t: any) => t.fontes), mundo.fonte,
];
const porOrgao = new Map<string, Set<string>>();
for (const f of todasFontes) {
  const curta = /\(série \d+ do SGS\)/.test(f.publicacao) ? 'Séries temporais (SGS)' : f.publicacao.replace(/ \(.*$/, '').replace(/^(PNAD Contínua( mensal)?|Novo Caged|IPCA|Pesquisa Nacional da Cesta Básica de Alimentos|Comex Stat|Resultado do Tesouro Nacional|Despesas por Função do Governo Central),.*$/, '$1').replace(/, versão.*$/, '').replace(/\s\d{4}$/, '').replace(/ \d{4} /, ' ').replace(/ \d{4},/, ',');
  if (!porOrgao.has(f.nome)) porOrgao.set(f.nome, new Set());
  porOrgao.get(f.nome)!.add(curta);
}
const fontesUsadas = [...porOrgao.entries()].map(([nome, pubs]) => ({ nome, pubs: [...pubs].join('; ') }));

// "Dados conferidos em": a busca mais recente nas fontes.
const conferido = [economia.baixadoEm, lavouras.baixadoEm, pecuaria.baixadoEm, industria.baixadoEm, servicos.baixadoEm, trabalho.baixadoEm, caged.baixadoEm, precosEstados.baixadoEm, comercio.baixadoEm, agora.baixadoEm, temasMundo.baixadoEm].filter(Boolean).sort().at(-1);
const seta = '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base temaAtual="">
  <div class="wrap">
    <section class="hero" aria-labelledby="h1">
      <div>
        <h1 id="h1">{site.slogan}</h1>
        <p class="lede">Cada número traz a fonte oficial e a data em que foi divulgado. Escolha um país no mapa ou um tema abaixo.</p>
        <div class="ctys">
          <div class="ctys-h"><span class="eyebrow">Países</span><span>{site.paises.filter((p) => p.disponivel).length} {site.paises.filter((p) => p.disponivel).length === 1 ? 'disponível' : 'disponíveis'}</span></div>
          {site.paises.filter((p) => p.disponivel).map((p) => (
            <a class="cty" href={p.href}><span class="sq"></span><span>{p.nome} <small>{p.resumo}</small></span><span class="go">Abrir <Fragment set:html={seta} /></span></a>
          ))}
          <div class="cty off"><span class="sq"></span><span>Outros países</span><span class="go"><span class="soon">{site.textos.emBreve}</span></span></div>
        </div>
      </div>
      <div class="mapbox">
        <svg class="wmap" viewBox={`0 0 ${mundo.largura} ${mundo.altura}`} role="img" aria-label="Mapa-múndi. Países disponíveis em destaque; os demais, em breve.">
          <defs>
            <pattern id="em-breve" patternUnits="userSpaceOnUse" width="5" height="5" patternTransform="rotate(45)">
              <rect width="5" height="5" class="pt-fundo" /><line x1="0" y1="0" x2="0" y2="5" class="pt-linha" />
            </pattern>
          </defs>
          <path class="sph" d={mundo.esfera} />
          <path class="grat" d={mundo.grade} />
          {mundo.unidades.filter((u: any) => !disponiveis.has(u.codigo)).map((u: any) => (
            <path class="c off" d={u.caminho} data-dica="em-breve" />
          ))}
          {mundo.unidades.filter((u: any) => disponiveis.has(u.codigo)).map((u: any) => {
            const p = disponiveis.get(u.codigo)!;
            const [x, y] = u.centro;
            return (
              <a href={p.href} class="c-link" aria-label={`${p.nome}, disponível. Abrir`} data-dica={p.nome} data-nota={p.resumo}>
                <path class="c on" d={u.caminho} />
                <line class="cl" x1={x} y1={y} x2={x - 120} y2={y + 70} />
                <circle class="pt" cx={x} cy={y} r="3" />
                <text class="lab" x={x - 126} y={y + 76} text-anchor="end">{p.nome}</text>
                <text class="lab2" x={x - 126} y={y + 94} text-anchor="end">disponível</text>
              </a>
            );
          })}
        </svg>
        <div class="tip" id="dica-mapa" role="tooltip"></div>
        <div class="mlegend">
          <div><i class="a"></i>Disponível</div>
          <div><i class="b"></i>Em breve</div>
          <em>Fronteiras: {mundo.fonte.nome}, 1:110 milhões</em>
        </div>
      </div>
    </section>

    <section class="now" aria-label="Agora">
      <div class="now-h"><span class="eyebrow">Agora</span><span>Indicadores do Brasil que mudam com frequência. Cada um traz a data a que se refere.</span></div>
      <div class="now-cards">
      {kpis.map((k: any) => (
        <div class="kpi">
          <div class="kpi-top"><span class="freq">{k.frequencia}</span><span class="sc">Brasil</span></div>
          <div class="kpi-v">
            <b>{k.partes.antes && <small>{k.partes.antes} </small>}{k.partes.numero}{k.partes.depois && <small>{k.partes.depois}</small>}</b>
            {k.texto && <span class={`d ${k.dir}`} title={k.comparacao}>{k.seta} {k.texto}</span>}
          </div>
          <div class="lbl">{k.rotulo}</div>
          <div class="cmp">{k.texto ? `Variação: ${k.comparacao}` : ''}</div>
          <div class="src">{k.fonteCurta} · {k.quando}</div>
        </div>
      ))}
      </div>
    </section>

    <section class="sec" id="temas" aria-labelledby="h-temas">
      <div class="sec-h"><h2 id="h-temas">Temas</h2><p>Um número de referência por tema, para o mundo.</p></div>
      <div class="themes">
        {temas.map((t) => {
          const corpo = (
            <>
              <div class="th-top"><span class="nm">{t.nome}</span>{t.ativo ? <span class="cta">Brasil <Fragment set:html={seta} /></span> : <span class="soon">{site.textos.emBreve}</span>}</div>
              <div class="big">{t.numero}{t.unidade && <small>{t.unidade}</small>}</div>
              <div class="ml">{t.rotulo}</div>
              <div class="src">{t.fonte}{t.origem && <><br />Dado original: {t.origem}</>}</div>
              <div class="ph">{t.descricao}</div>
            </>
          );
          return t.ativo ? <a class="th on" href={t.href}>{corpo}</a> : <div class="th off" aria-disabled="true">{corpo}</div>;
        })}
      </div>
      <details class="todos recolhe-no-celular" id="todos-os-temas" open>
        <summary>Ver todos os {temasPorGrupo().reduce((s, g) => s + g.temas.length, 0)} temas</summary>
        <h3>Todos os temas</h3>
        <div class="todos-grade">
          {temasPorGrupo().map((g) => (
            <div class="todos-grupo">
              <h4>{g.nome}</h4>
              <ul>
                {g.temas.map((t) => (
                  <li>{t.situacao === 'no-ar' && t.href ? <a href={t.href}>{t.nome}</a> : <span class="off">{t.nome} <span class="soon">{site.textos.emBreve}</span></span>}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </section>

    <section class="sec" aria-labelledby="h-hist">
      <div class="sec-h"><h2 id="h-hist">Explore</h2><p>Mapas e guias feitos a partir dos dados.</p></div>
      <div class="stories">
        {historias.map((h) => (
          <a class={`st${h.lead ? ' lead' : ''}`} href={h.href}>
            <span class="k">{h.k}</span>
            <h3>{h.t}</h3>
            <p>{h.p}</p>
            <div class="m">{h.m.map((x) => <span>{x}</span>)}</div>
          </a>
        ))}
      </div>
    </section>

    <footer class="pg">
      <div class="ft">
        <details class="recolhe-no-celular" open>
          <summary>Fontes usadas</summary>
          <h4>Fontes usadas</h4>
          <ul>{fontesUsadas.map((f) => <li><b>{f.nome}</b>, {f.pubs}</li>)}</ul>
        </details>
        <details class="recolhe-no-celular" open>
          <summary>Como lemos os dados</summary>
          <h4>Como lemos os dados</h4>
          <p>Usamos números publicados por fontes oficiais. Quando fazemos uma conta com eles (por exemplo, PIB por pessoa = PIB ÷ população), dizemos qual foi a conta ao lado do número. Ao lado de cada valor aparecem a fonte, o período a que ele se refere e a data de divulgação. Valores em moeda são correntes, salvo indicação. Os mapas usam seis faixas por medida. Quando a moeda ou a escala muda de um país para outro, as faixas daquele país são ajustadas e aparecem na legenda.</p>
        </details>
        <div>
          <h4>Sem dado</h4>
          <div class="nd">
            <p>Quando a fonte não publica um número, mostramos “sem dado”, nunca zero.</p>
            <div><i class="i-sem"></i>Hachura: sem dado</div>
            <div><i class="i-zero"></i>Cinza liso: não produz</div>
            <div><i class="i-breve"></i>Cinza com hachura: país em breve</div>
          </div>
        </div>
      </div>
      <div class="ft-b"><span>{site.nome} · Dados abertos de fontes oficiais. Cada número traz fonte e data de divulgação.</span>{conferido && <span>Dados conferidos nas fontes em {dataLonga(conferido)}</span>}</div>
    </footer>
  </div>
</Base>

<script>
  // Dica ao passar o mouse no mapa-múndi (igual ao design): país disponível ou "em breve".
  const caixa = document.querySelector('.mapbox') as HTMLElement | null;
  const dica = document.getElementById('dica-mapa');
  const mapa = caixa?.querySelector('.wmap');
  if (caixa && dica && mapa) {
    mapa.addEventListener('mousemove', (e) => {
      const ev = e as MouseEvent;
      const alvo = (ev.target as Element).closest('[data-dica]') as HTMLElement | SVGElement | null;
      if (!alvo) { dica.style.display = 'none'; return; }
      const d = alvo.dataset;
      dica.innerHTML = d.dica === 'em-breve'
        ? '<b>Em breve</b><span>Ainda sem dados neste país</span>'
        : `<b>${d.dica}</b><span>${d.nota} · clique para abrir</span>`;
      const r = caixa.getBoundingClientRect();
      dica.style.display = 'block';
      dica.style.left = Math.min(ev.clientX - r.left + 14, r.width - dica.offsetWidth) + 'px';
      dica.style.top = ev.clientY - r.top + 14 + 'px';
    });
    mapa.addEventListener('mouseleave', () => { dica.style.display = 'none'; });
  }
</script>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 40px; }
  :global(.ic) { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex: none; vertical-align: -.15em; }
  .eyebrow { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--sub); font-weight: 600; }
  .soon { font-size: 11px; letter-spacing: .04em; text-transform: uppercase; border: 1px dashed var(--line2); border-radius: 4px; padding: 1px 5px; color: var(--faint); white-space: nowrap; font-weight: 400; }
  .freq { display: inline-flex; align-items: center; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--sub); border: 1px solid var(--line2); border-radius: 4px; padding: 2px 6px; line-height: 1.3; white-space: nowrap; }

  /* abertura */
  .hero { display: grid; grid-template-columns: 400px minmax(0, 1fr); gap: 48px; align-items: center; padding: 56px 0 40px; }
  .hero h1 { font-size: 64px; line-height: 1.02; letter-spacing: -.03em; font-weight: 600; margin: 0; text-wrap: balance; }
  .lede { font-size: 20px; line-height: 1.5; color: var(--sub); margin: 24px 0 0; text-wrap: pretty; }
