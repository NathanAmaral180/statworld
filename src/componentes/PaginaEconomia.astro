---
// Páginas de Economia de um país feitas de mapa + ranking por estado: a Visão geral e abas como Impostos e Trabalho e renda.
// Serve para qualquer país: tudo que muda vem do arquivo do país (src/config/paises/)
// e da configuração da aba (src/config/temas/).
import Base from '../layouts/Base.astro';
import Abas from './Abas.astro';
import FaixaHoje from './FaixaHoje.astro';
import MapaRanking from './mapa-ranking/MapaRanking.astro';
import GraficoSerie from './GraficoSerie.astro';
import ListaBarras from './ListaBarras.astro';
import CartaoBalanca from './CartaoBalanca.astro';
import PainelSeries from './PainelSeries.astro';
import CadaCem from './CadaCem.astro';
import Vistas from './Vistas.astro';
import EspacoAnuncio from './EspacoAnuncio.astro';
import { construirVisaoIndicador, type Medida } from './mapa-ranking/construir-indicador';
import { preencher, dataCurta, formatar, quandoCurto } from './mapa-ranking/visao';
import site from '../config/site.json';
import { abasDe } from '../lib/catalogo';
import economiaEstados from '../config/temas/economia-estados.json';
import impostosEstados from '../config/temas/impostos-estados.json';
import trabalhoEstados from '../config/temas/trabalho-estados.json';
import precosEstados from '../config/temas/precos-estados.json';
import comercioEstados from '../config/temas/comercio-estados.json';
import dinheiroBrasil from '../config/temas/dinheiro-brasil.json';
import contasBrasil from '../config/temas/contas-publicas-brasil.json';
import { carregarDados } from '../lib/dados';
import { contextoDoPais } from '../lib/contexto';

// Configuração de cada aba feita com este molde.
const CONFIGS: Record<string, any> = { 'visao-geral': economiaEstados, impostos: impostosEstados, 'trabalho-renda': trabalhoEstados, precos: precosEstados, 'comercio-exterior': comercioEstados, 'dinheiro-juros': dinheiroBrasil, 'contas-publicas': contasBrasil };

interface Props { pais: any; aba?: string; teste?: boolean }
const { pais, aba = 'visao-geral', teste = false } = Astro.props;
const tema = CONFIGS[aba];
if (!tema) throw new Error(`Aba sem configuração: ${aba}`);

const NIVEL = 'estado';
const { geo, ctx, unidades, mapa } = contextoDoPais(pais, NIVEL);
// Pasta de dados da aba (padrão: economia). O nome do arquivo vem do país (arquivos.<pasta>.<nível>).
const pastaDados = tema.dados ?? 'economia';
// Abas só com painel de séries (ex.: Dinheiro e juros) não têm dado por estado.
// Abas sem mapa por estado (só painéis, ex.: Contas públicas): botões de vista sem mapa.
const semMapa = !tema.medidas?.length;
const painelSeries = tema.painelSeries ? carregarDados<any>(pastaDados, pais.arquivos[pastaDados][tema.painelSeries.arquivo]) : null;
const economiaBase = painelSeries || semMapa ? { indicadores: {} } : carregarDados<any>(pastaDados, pais.arquivos[pastaDados][NIVEL]);
// Arquivos extras da mesma pasta (ex.: Novo Caged), juntados aos indicadores da aba.
const extrasDados = (pais.arquivos[pastaDados]?.extras ?? []).map((nome: string) => carregarDados<any>(pastaDados, nome));
const economia = { ...economiaBase, indicadores: Object.assign({}, economiaBase.indicadores, ...extrasDados.map((x: any) => x.indicadores)) };

// As medidas podem ser escritas na própria aba ou escolhidas pelo id entre as da Visão geral.
const todasMedidas = economiaEstados.medidas as Medida[];
const medidasDaAba: Medida[] = tema.medidas.map((m: any) =>
  typeof m === 'string' ? todasMedidas.find((x) => x.id === m) ?? (() => { throw new Error(`Medida desconhecida: ${m}`); })() : m
);
// Cortes das cores: os do tema, a não ser que o país tenha os seus (moeda e escala mudam).
const cortesPais = pais.cortes?.['economia-estados'] ?? {};
const medidas = medidasDaAba
  .filter((m) => economia.indicadores[m.id])
  .map((m) => ({ ...m, cortes: cortesPais[m.id] ?? m.cortes }));
const visoes = Object.fromEntries(medidas.map((m) => [m.id, construirVisaoIndicador(m.id, unidades, economia.indicadores[m.id], m, ctx, economia.indicadores)]));
// Carimbo "selo + fonte · data" de um conjunto de fontes.
const carimboDe = (frequencia: string | undefined, fontes: any[]) => {
  const f = fontes[0];
  return { selo: frequencia, texto: `${f.nome}, ${f.publicacao}${quandoCurto(f, ctx)}` };
};
const opcoes: any[] = medidas.map((m) => ({
  id: m.id,
  rotulo: preencher(m.rotulo, { periodo: economia.indicadores[m.id].periodo }),
  visao: m.id,
  carimbo: tema.carimboNosBotoes ? carimboDe(economia.indicadores[m.id].frequencia, economia.indicadores[m.id].fontes) : undefined,
}));

// Painéis: vistas com gráficos no tempo no lugar do mapa (config "paineis" da aba).
// Sem "largo", a ficha e o ranking da medida padrão continuam ao lado; com "largo", o painel ocupa tudo e tem o próprio resumo.
const pegar = (obj: any, caminho: string) => caminho.split('.').reduce((o, k) => o?.[k], obj);
const fmtNum = (v: number | null, formato: any, casas: number) => formatar(v, { formato, casas }, ctx);
// Cartão da balança comercial (config "balanca"): no alto da lateral do mapa e ao lado das listas.
const arqBalanca = tema.balanca && pais.arquivos[pastaDados]?.[tema.balanca.arquivo];
const balanca = arqBalanca ? carregarDados<any>(pastaDados, arqBalanca) : null;
const paineis = (tema.paineis ?? []).flatMap((cfg: any) => {
  const arq = pais.arquivos[pastaDados]?.[cfg.arquivo];
  if (!arq) return [];
  const dados = carregarDados<any>(pastaDados, arq);
  // "Cada R$ 100" (quadradinhos de onde vem e para onde vai o dinheiro).
  if (cfg.tipo === 'cem') {
    return [{ cfg, cem: true, opcao: { id: cfg.id, rotulo: cfg.rotulo, painel: true, largo: true, carimbo: carimboDe(dados.frequencia, dados.fontes) }, props: { dados, textos: cfg.textos } }];
  }
  // Painel de lista com barras (ex.: principais produtos).
  if (cfg.tipo === 'lista') {
    const fl = dados.fontes[0];
    return [{
      cfg,
      lista: true,
      opcao: { id: cfg.id, rotulo: cfg.rotulo, visao: tema.medidaPadrao, painel: true, largo: true, carimbo: carimboDe(dados.frequencia, dados.fontes) },
      props: {
        titulo: preencher(cfg.titulo, { periodo: dados.periodo }), descricao: cfg.descricao,
        itens: dados[cfg.lista], formato: cfg.formato, casas: cfg.casas, compacto: cfg.compacto, moeda: cfg.moeda, cabecalhos: cfg.cabecalhos,
        nota: cfg.nota ? preencher(cfg.nota, { periodo: dados.periodo, total: formatar(dados.total, { formato: cfg.formato, casas: cfg.casas, compacto: cfg.compacto }, cfg.moeda ? { ...ctx, moeda: cfg.moeda } : ctx), fonte: `${fl.nome}, ${fl.publicacao}` }) : undefined,
      },
    }];
  }
  const series = cfg.series.map((c: any) => ({ ...c, ...pegar(dados, c.caminho) }));
  const s0 = series[0];
  const fim = [...s0.pontos].reverse().find((x: any) => x.valor != null);
  let resumo;
  if (cfg.resumo?.tipo === 'meta') {
    const u = dados.ultimo;
    const dif = Math.round((u.valor - u.max) * 100) / 100;
    const acima = dif > 0;
    const pts = formatar(Math.abs(acima ? dif : u.valor - u.max), { formato: 'numero', casas: 2 }, ctx);
    resumo = {
      topo: `${pais.nome} · ${dados.periodo}`, nome: cfg.resumo.nome,
      numero: fmtNum(u.valor, 'numero', 2), depois: '%',
      linhas: [
        [cfg.resumo.rotuloMeta, fmtNum(u.meta, 'percentual', 1)],
        [cfg.resumo.rotuloIntervalo, `${fmtNum(u.min, 'percentual', 1)} a ${fmtNum(u.max, 'percentual', 1)}`],
        [cfg.resumo.rotuloTeto, `${pts} ${Math.abs(u.valor - u.max) === 1 ? 'ponto' : 'pontos'} ${acima ? 'acima' : 'abaixo'}`],
      ],
      carimbos: s0.fontes.map((f: any, i: number) => carimboDe(i === 0 ? s0.frequencia : undefined, [f])),
    };
  } else if (cfg.resumo?.tipo === 'ultimo') {
    const comValor = s0.pontos.filter((x: any) => x.valor != null);
    const maior = comValor.reduce((a: any, b: any) => (b.valor > a.valor ? b : a));
    const menor = comValor.reduce((a: any, b: any) => (b.valor < a.valor ? b : a));
    resumo = {
      topo: preencher(cfg.resumo.topo, { pais: pais.nome, periodo: fim.nome }), nome: cfg.resumo.nome,
      numero: fmtNum(fim.valor, s0.formato, s0.casas), depois: cfg.resumo.unidade,
      linhas: [
        ...(cfg.resumo.campos ?? []).map((c: any) => [c.rotulo, fmtNum(pegar(dados, c.caminho), c.formato, c.casas)]),
        [cfg.resumo.rotuloMaior, `${fmtNum(maior.valor, s0.formato, s0.casas)} em ${maior.nome}`],
        [cfg.resumo.rotuloMenor, `${fmtNum(menor.valor, s0.formato, s0.casas)} em ${menor.nome}`],
      ],
      carimbos: s0.fontes.map((f: any, i: number) => carimboDe(i === 0 ? s0.frequencia : undefined, [f])),
    };
  }
  const inicio = s0.pontos[0]?.nome.match(/[0-9]{4}/)?.[0] ?? '';
  return [{
    cfg,
    opcao: { id: cfg.id, rotulo: cfg.rotulo, visao: tema.medidaPadrao, painel: true, largo: !!cfg.largo, carimbo: carimboDe(s0.frequencia, s0.fontes) },
    props: {
      titulo: preencher(cfg.titulo, { inicio }), descricao: cfg.descricao, tipo: cfg.tipo ?? 'linhas', legenda: cfg.legenda, resumo,
      series: series.map((x: any) => ({ titulo: x.titulo, formato: x.formato, casas: x.casas, faixa: x.faixa, zero: x.zero, pontos: x.pontos })),
    },
  }];
});
// Ordem dos botões: painéis marcados "antes" vêm antes das medidas do mapa.
const opcoesFinais = [
  ...paineis.filter((p: any) => p.cfg.posicao === 'antes').map((p: any) => p.opcao),
  ...opcoes,
  ...paineis.filter((p: any) => p.cfg.posicao !== 'antes').map((p: any) => p.opcao),
];
const opcaoInicial = tema.opcaoInicial ?? tema.medidaPadrao;

// Faixa "<Assunto> hoje": só aparece se o país tem o arquivo de dados dela.
const arqHoje = tema.faixaHoje && pais.arquivos?.[tema.faixaHoje.grupo]?.hoje;
const hoje = arqHoje ? carregarDados<any>(tema.faixaHoje.grupo, arqHoje) : null;

const vars = { pais: pais.nome, dePais: pais.dePais };
const titulo = preencher(tema.titulo, vars);
const trilha = tema.trilha.map((t: string) => preencher(t, vars));
const cabMapa = tema.cabecalhoMapa;
const indPrincipal = cabMapa ? economia.indicadores[medidas[0]?.id] : null;
const fontePrincipal = indPrincipal?.fontes?.[0];
// Abas de Economia (com grupos) vêm do cadastro; as que o país ainda não tem aparecem "em breve".
const abas = abasDe('economia', pais);
const tituloPagina = aba === 'visao-geral' ? titulo : `${abas.find((a: any) => a.id === aba)?.nome ?? aba} · ${titulo}`;
---
<Base titulo={tituloPagina} temaAtual="economia" naoIndexar={teste}>
  <section class="conteudo pagina">
    {teste && <p class="aviso-teste">Página de teste: ainda não aparece no menu do site.</p>}
    <p class="trilha">{trilha.join(' / ')}</p>
    <h1>{titulo}</h1>
    <Abas itens={abas} atual={aba} rotulo="Economia" emBreve={site.textos.emBreve} />
    {cabMapa && (
      <div class="cab-mapa">
        <div><h2>{cabMapa.titulo}</h2><p>{indPrincipal?.periodo}. {cabMapa.descricao}</p></div>
        {fontePrincipal && (
          <p class="carimbo">
            {indPrincipal.frequencia && <span class="selo">{indPrincipal.frequencia}</span>}
            <span>{fontePrincipal.nome}, {fontePrincipal.publicacao}{fontePrincipal.dataDivulgacao && ` · ${dataCurta(fontePrincipal.dataDivulgacao, ctx)}`}</span>
          </p>
        )}
      </div>
    )}
    {painelSeries && <PainelSeries series={painelSeries.series} ctx={ctx} textos={tema.painelSeries.textos} />}
    {semMapa && !painelSeries && (
      <Vistas opcoes={opcoesFinais} inicial={opcaoInicial} rotulo={tema.rotuloVistas ?? ''}>
        {paineis.filter((p: any) => p.cem).map((p: any) => <CadaCem {...p.props} ctx={ctx} painelDe={p.cfg.id} oculto={p.cfg.id !== opcaoInicial} />)}
        {paineis.filter((p: any) => p.lista).map((p: any) => <ListaBarras {...p.props} ctx={ctx} painelDe={p.cfg.id} oculto={p.cfg.id !== opcaoInicial} />)}
        {paineis.filter((p: any) => !p.lista && !p.cem).map((p: any) => <GraficoSerie {...p.props} ctx={ctx} painelDe={p.cfg.id} oculto={p.cfg.id !== opcaoInicial} />)}
      </Vistas>
    )}
    {!painelSeries && !semMapa && <MapaRanking geo={geo} mapa={mapa} ctx={ctx} opcoes={opcoesFinais} opcaoInicial={opcaoInicial} visoes={visoes} ranking={tema.ranking}>
      {balanca && <CartaoBalanca slot="lateral" dados={balanca} ctx={ctx} textos={tema.balanca.textos} />}
      {paineis.filter((p: any) => p.lista).map((p: any) => (
        <ListaBarras slot="painel" {...p.props} ctx={ctx} painelDe={p.cfg.id} oculto={p.cfg.id !== opcaoInicial} balanca={balanca} textosBalanca={tema.balanca?.textos} />
      ))}
      {paineis.filter((p: any) => !p.lista).map((p: any) => (
        <GraficoSerie slot="painel" {...p.props} ctx={ctx} painelDe={p.cfg.id} oculto={p.cfg.id !== opcaoInicial} />
      ))}
    </MapaRanking>}
    {/* Faixa "<Assunto> hoje": só aparece se a aba tiver "faixaHoje" na configuração (hoje nenhuma tem: o dono tirou). */}
    {hoje && <FaixaHoje rotulo={tema.faixaHoje.rotulo} descricao={tema.faixaHoje.descricao} indicadores={hoje.indicadores} ctx={ctx} />}
    <EspacoAnuncio posicao="abaixo-ranking" />
  </section>
</Base>

<style>
  .pagina { padding-top: 40px; padding-bottom: 80px; }
  .aviso-teste { display: inline-block; margin: 0 0 16px; padding: 6px 12px; font-size: 14px; color: var(--sub); background: var(--surf); border: 1px dashed var(--line2); border-radius: 8px; }
  .trilha { margin: 0 0 12px; color: var(--sub); font-size: 17px; }
  h1 { margin: 0 0 24px; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
  .cab-mapa { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 28px 0 28px; }
  .cab-mapa h2 { font-size: 20px; font-weight: 600; letter-spacing: -.01em; margin: 0; }
  .cab-mapa p { margin: 4px 0 0; color: var(--sub); font-size: 15px; }
  .cab-mapa .carimbo { display: flex; gap: 6px 8px; align-items: center; flex-wrap: wrap; font-size: 13px; color: var(--faint); line-height: 1.4; margin: 0; }
  .selo { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--sub); border: 1px solid var(--line2); border-radius: 4px; padding: 2px 6px; line-height: 1.3; white-space: nowrap; }
</style>
