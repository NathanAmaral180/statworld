---
// Páginas de Economia de um país feitas de mapa + ranking por estado: a Visão geral e abas como Impostos.
// Serve para qualquer país: tudo que muda vem do arquivo do país (src/config/paises/)
// e da configuração da aba (src/config/temas/).
import Base from '../layouts/Base.astro';
import Abas from './Abas.astro';
import FaixaHoje from './FaixaHoje.astro';
import MapaRanking from './mapa-ranking/MapaRanking.astro';
import EspacoAnuncio from './EspacoAnuncio.astro';
import { construirVisaoIndicador, type Medida } from './mapa-ranking/construir-indicador';
import { preencher, dataCurta } from './mapa-ranking/visao';
import site from '../config/site.json';
import { abasDe } from '../lib/catalogo';
import economiaEstados from '../config/temas/economia-estados.json';
import impostosEstados from '../config/temas/impostos-estados.json';
import { carregarDados } from '../lib/dados';
import { contextoDoPais } from '../lib/contexto';

// Configuração de cada aba feita com este molde.
const CONFIGS: Record<string, any> = { 'visao-geral': economiaEstados, impostos: impostosEstados };

interface Props { pais: any; aba?: string; teste?: boolean }
const { pais, aba = 'visao-geral', teste = false } = Astro.props;
const tema = CONFIGS[aba];
if (!tema) throw new Error(`Aba sem configuração: ${aba}`);

const NIVEL = 'estado';
const { geo, ctx, unidades, mapa } = contextoDoPais(pais, NIVEL);
const economia = carregarDados<any>('economia', pais.arquivos.economia[NIVEL]);

// As medidas podem ser escritas na própria aba ou escolhidas pelo id entre as da Visão geral.
const todasMedidas = economiaEstados.medidas as Medida[];
const medidasDaAba: Medida[] = tema.medidas.map((m: any) =>
  typeof m === 'string' ? todasMedidas.find((x) => x.id === m) ?? (() => { throw new Error(`Medida desconhecida: ${m}`); })() : m
);
// Cortes das cores: os do tema, a não ser que o país tenha os seus (moeda e escala mudam).
const cortesPais = pais.cortes?.['economia-estados'] ?? {};
const medidas = medidasDaAba
  .filter((m) => economia.indicadores[m.id])
  .map((m) => ({ ...m, cortes: cortesPais[m.id] ?? m.cortes }));
const visoes = Object.fromEntries(medidas.map((m) => [m.id, construirVisaoIndicador(m.id, unidades, economia.indicadores[m.id], m, ctx)]));
const opcoes = medidas.map((m) => ({ id: m.id, rotulo: preencher(m.rotulo, { periodo: economia.indicadores[m.id].periodo }), visao: m.id }));

// Faixa "<Assunto> hoje": só aparece se o país tem o arquivo de dados dela.
const arqHoje = tema.faixaHoje && pais.arquivos?.[tema.faixaHoje.grupo]?.hoje;
const hoje = arqHoje ? carregarDados<any>(tema.faixaHoje.grupo, arqHoje) : null;

const vars = { pais: pais.nome, dePais: pais.dePais };
const titulo = preencher(tema.titulo, vars);
const trilha = tema.trilha.map((t: string) => preencher(t, vars));
const cabMapa = tema.cabecalhoMapa;
const indPrincipal = cabMapa ? economia.indicadores[medidas[0]?.id] : null;
const fontePrincipal = indPrincipal?.fontes?.[0];
// Abas de Economia (com grupos) vêm do cadastro; as que o país ainda não tem aparecem "em breve".
const abas = abasDe('economia', pais);
const tituloPagina = aba === 'visao-geral' ? titulo : `${abas.find((a: any) => a.id === aba)?.nome ?? aba} · ${titulo}`;
---
<Base titulo={tituloPagina} temaAtual="economia" naoIndexar={teste}>
  <section class="conteudo pagina">
    {teste && <p class="aviso-teste">Página de teste: ainda não aparece no menu do site.</p>}
    <p class="trilha">{trilha.join(' / ')}</p>
    <h1>{titulo}</h1>
    <Abas itens={abas} atual={aba} rotulo="Economia" emBreve={site.textos.emBreve} />
    {cabMapa && (
      <div class="cab-mapa">
        <div><h2>{cabMapa.titulo}</h2><p>{indPrincipal?.periodo}. {cabMapa.descricao}</p></div>
        {fontePrincipal && (
          <p class="carimbo">
            {indPrincipal.frequencia && <span class="selo">{indPrincipal.frequencia}</span>}
            <span>{fontePrincipal.nome}, {fontePrincipal.publicacao}{fontePrincipal.dataDivulgacao && ` · ${dataCurta(fontePrincipal.dataDivulgacao, ctx)}`}</span>
          </p>
        )}
      </div>
    )}
    <MapaRanking geo={geo} mapa={mapa} ctx={ctx} opcoes={opcoes} opcaoInicial={tema.medidaPadrao} visoes={visoes} ranking={tema.ranking} />
    {/* Faixa "<Assunto> hoje": só aparece se a aba tiver "faixaHoje" na configuração (hoje nenhuma tem: o dono tirou). */}
    {hoje && <FaixaHoje rotulo={tema.faixaHoje.rotulo} descricao={tema.faixaHoje.descricao} indicadores={hoje.indicadores} ctx={ctx} />}
    <EspacoAnuncio posicao="abaixo-ranking" />
  </section>
</Base>

<style>
  .pagina { padding-top: 40px; padding-bottom: 80px; }
  .aviso-teste { display: inline-block; margin: 0 0 16px; padding: 6px 12px; font-size: 14px; color: var(--sub); background: var(--surf); border: 1px dashed var(--line2); border-radius: 8px; }
  .trilha { margin: 0 0 12px; color: var(--sub); font-size: 17px; }
  h1 { margin: 0 0 24px; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
  .cab-mapa { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 28px 0 28px; }
  .cab-mapa h2 { font-size: 20px; font-weight: 600; letter-spacing: -.01em; margin: 0; }
  .cab-mapa p { margin: 4px 0 0; color: var(--sub); font-size: 15px; }
  .cab-mapa .carimbo { display: flex; gap: 6px 8px; align-items: center; flex-wrap: wrap; font-size: 13px; color: var(--faint); line-height: 1.4; margin: 0; }
  .selo { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--sub); border: 1px solid var(--line2); border-radius: 4px; padding: 2px 6px; line-height: 1.3; white-space: nowrap; }
</style>
