---
// Botões de vista (ex.: "Cada R$ 100 / Dívida pública / Gasto por função") para abas SEM mapa por estado.
// Cada botão mostra o painel com data-painel-de=<id> (vindo no slot) e o carimbo "selo + fonte · data" dele.
// Mesmo visual dos botões do MapaRanking.
interface Opcao { id: string; rotulo: string; rotuloCurto?: string; carimbo?: { selo?: string; texto: string } }
interface Props { opcoes: Opcao[]; inicial: string; rotulo: string }
const { opcoes, inicial, rotulo } = Astro.props;
---
<div class="vs" data-vistas>
  <div class="vs-controles">
    <div class="vs-botoes" role="group" aria-label={rotulo}>
      {opcoes.map((o) => <button type="button" data-vista={o.id} aria-pressed={String(o.id === inicial)}>{o.rotuloCurto ? <><span class="so-pc">{o.rotulo}</span><span class="so-cel">{o.rotuloCurto}</span></> : o.rotulo}</button>)}
    </div>
    {opcoes.filter((o) => o.carimbo).map((o) => (
      <p class="vs-carimbo" data-carimbo-de={o.id} hidden={o.id !== inicial}>{o.carimbo!.selo && <span class="selo">{o.carimbo!.selo}</span>}<span>{o.carimbo!.texto}</span></p>
    ))}
  </div>
  <slot />
</div>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-vistas]')) {
    raiz.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-vista]');
      if (!b) return;
      const id = b.dataset.vista!;
      raiz.querySelectorAll('[data-vista]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      raiz.querySelectorAll<HTMLElement>('[data-carimbo-de]').forEach((c) => { c.hidden = c.dataset.carimboDe !== id; });
      raiz.querySelectorAll<HTMLElement>('[data-painel-de]').forEach((p) => { p.hidden = p.dataset.painelDe !== id; });
    });
  }
</script>

<style>
  .vs-controles { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-bottom: 28px; }
  .vs-botoes { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--surf); border: 1px solid var(--line); border-radius: 12px; }
  .vs-botoes button { font: inherit; font-size: 16px; color: var(--sub); background: transparent; border: 0; border-radius: 9px; padding: 10px 18px; cursor: pointer; }
  .vs-botoes button:hover { color: var(--ink); }
  .vs-botoes button[aria-pressed="true"] { background: var(--bg); color: var(--ink); font-weight: 600; box-shadow: 0 0 0 1px var(--line), 0 1px 3px var(--line); }
  .vs-botoes button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .vs-carimbo { display: flex; gap: 6px 8px; align-items: center; flex-wrap: wrap; margin: 0; font-size: 13px; color: var(--faint); line-height: 1.4; }
  .vs-carimbo[hidden] { display: none; }
  .selo { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--sub); border: 1px solid var(--line2); border-radius: 4px; padding: 2px 6px; line-height: 1.3; white-space: nowrap; }
  @media (max-width: 640px) {
    .vs-botoes { display: flex; width: 100%; }
    /* presos no topo ao rolar, logo abaixo das abas (--topo-fixo vem de Abas.astro) */
    .vs-controles { display: contents; }
    .vs-controles > * { margin-bottom: 12px; }
    .vs-botoes { position: sticky; top: var(--topo-fixo, 0px); z-index: 20; box-shadow: 0 0 0 6px var(--bg); }
    .vs-botoes button { flex: 1; font-size: 14px; padding: 8px 10px; }
  }
</style>
