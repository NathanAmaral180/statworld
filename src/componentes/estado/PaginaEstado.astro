---
// Página de Economia de um estado, com o mapa dos seus municípios. Design: design/rodada-5-estado/.
// Serve para qualquer estado com dados (pais.estados.comPagina) e qualquer aba de src/config/temas/economia-municipios.json.
// Cada aba fica de um jeito: mapa dos municípios ('mun'), sem dado neste nível ('sem') ou em breve ('breve').
import Base from '../../layouts/Base.astro';
import Abas from '../Abas.astro';
import EspacoAnuncio from '../EspacoAnuncio.astro';
import './estado.css';
import site from '../../config/site.json';
import { preencher } from '../mapa-ranking/visao';
import { CFG, nomesDoEstado, listaEstados, abaDoEstado, abasDoEstado, enderecoEstado, malhaDoEstado, medidasDoEstado, agoraDoEstado, bandeirasDoEstado } from '../../lib/estado';

interface Props { pais: any; uf: string; aba?: string }
const { pais, uf, aba = 'visao-geral' } = Astro.props;
const N = nomesDoEstado(pais, uf);
const nivel = pais.estados.nivel;
const t = CFG.textos;
const tema = abaDoEstado(pais, uf, aba);
const abas = abasDoEstado(pais, uf);
const abaAtual = abas.find((a: any) => a.id === aba);
const vars = { deEstado: N.de, emEstado: N.em };
const titulo = preencher(CFG.titulo, vars);
const G = malhaDoEstado(pais, uf);
const codigos = Object.keys(G.mun);
const nRegioes = Object.keys(G.regioes).length;
const capital = pais.estados.comPagina[uf].capital;
const agora = agoraDoEstado(pais, uf);
const bandeiras = bandeirasDoEstado(pais, uf);
const bandeiraEstado = bandeiras.estado;
const bandeirasCidades = Object.fromEntries(Object.entries(bandeiras).filter(([k]) => k !== 'estado').map(([k, b]) => [k, { a: b.arquivo, c: b.credito, p: b.pagina }]));
const estados = listaEstados(pais);
const medidas = tema.situacao === 'mun' ? medidasDoEstado(pais, uf, aba, codigos) : [];
const dados = tema.situacao === 'mun' ? {
  ...G, capital, inicial: capital, bandeiras: bandeirasCidades, idioma: pais.idioma, medidas, t, nivel, emEstado: N.em, deEstado: N.de,
  nomePais: pais.nome, totalPais: nivel.totalPais, fonteRegioes: pais.estados.fonteRegioes, fonteMalha: `${G.fonte.nome}, ${G.fonte.publicacao}`,
} : null;
// Abas com mapa dos municípios deste estado (para as páginas "sem dado" e "em breve").
const comMapa = abas.filter((a: any) => a.id !== aba && abaDoEstado(pais, uf, a.id).situacao === 'mun');
const nomeAba = abaAtual?.nome ?? aba;
const tituloPagina = aba === 'visao-geral' ? titulo : `${nomeAba} · ${titulo}`;
const descricao = preencher(CFG.descricao, { ...vars, medidas: medidas.length ? medidas.map((m: any) => m.rotulo.toLowerCase()).join(', ') : nomeAba.toLowerCase() });
const seta = '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const chev = '<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>';
const lupa = '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>';
const nf = (n: number) => n.toLocaleString(pais.idioma);
const destaque = pais.estados.comPagina[uf].destaque;
const estiloCores = destaque ? `--est-destaque-claro:${destaque.claro};--est-destaque-escuro:${destaque.escuro}` : undefined;
---
<Base titulo={tituloPagina} descricao={descricao} temaAtual="economia">
  <section class="conteudo pagina est" style={estiloCores} data-estado-mun={tema.situacao === 'mun' ? '' : undefined}>
    <nav class="trilha" aria-label="Você está em">
      <span>Economia</span><span aria-hidden="true">/</span><a href={abaAtual?.hrefBrasil ?? '/economia'}>{pais.nome}</a><span aria-hidden="true">/</span>
      <div class="pk">
        <button type="button" class="pk-b" aria-haspopup="dialog" aria-expanded="false" aria-controls="pk-pop">{N.nome}<Fragment set:html={chev} /><span class="sr">, trocar de estado</span></button>
        <div class="pk-pop" id="pk-pop" role="dialog" aria-label="Trocar de estado" hidden>
          <div class="fld"><Fragment set:html={lupa} /><input type="text" placeholder="Buscar estado" aria-label="Buscar estado" autocomplete="off" spellcheck="false" /></div>
          <div class="pk-l">
            {estados.map((g) => (
              <div role="group" aria-label={g.regiao}>
                <div class="pk-g" aria-hidden="true">{g.regiao}</div>
                {g.estados.map((e: any) => e.temPagina
                  ? <a href={enderecoEstado(e.uf, aba)} data-nome={e.nome} data-uf={e.uf} aria-current={e.uf === uf ? 'page' : undefined}>{e.nome}<span>{e.uf === uf ? 'atual' : e.uf}</span></a>
                  : <span class="pk-off" data-nome={e.nome} data-uf={e.uf}>{e.nome}<em class="soon">{site.textos.emBreve}</em></span>)}
              </div>
            ))}
            <div class="pk-e" hidden>Nenhum estado com esse nome.</div>
          </div>
        </div>
      </div>
      {aba !== 'visao-geral' && <><span aria-hidden="true">/</span><span aria-current="page">{nomeAba}</span></>}
    </nav>
    <h1>{bandeiraEstado && <img class="est-bandeira" src={bandeiraEstado.arquivo} alt={`Bandeira ${N.de}`} title={`Bandeira ${N.de} · ${bandeiraEstado.credito}`} />}{titulo}</h1>
    <div class="est-sum">
      <span><b>{nf(codigos.length)}</b> {nivel.plural}</span>
      <span><b>{nRegioes}</b> regiões intermediárias</span>
      {G.mun[capital] && <span>Capital: <b>{G.mun[capital].n}</b></span>}
      <span>Região {N.regiaoPais}</span>
      {agora && <span class="est-agora" title={`${agora.fonte}. ${agora.observacao}`}>{preencher(t.agora, { ano: agora.ano })}: <b>{preencher(t.agoraTexto, { valor: agora.valor, mes: agora.mes })}</b> <span class="selo">{agora.frequencia}</span></span>}
    </div>
    <Abas itens={abas} atual={aba} rotulo="Economia" emBreve={site.textos.emBreve} />

    {tema.situacao === 'mun' && (
      <>
        <div class="ctrl">
          {medidas.length > 1
            ? <div class="seg" id="est-seg" role="tablist" aria-label="Medida">{medidas.map((m: any, i: number) => <button type="button" role="tab" data-k={m.id} class={i === 0 ? 'on' : ''} aria-selected={i === 0 ? 'true' : 'false'}>{m.rotuloCurto ? <><span class="so-pc">{m.rotulo}</span><span class="so-cel">{m.rotuloCurto}</span></> : m.rotulo}</button>)}</div>
            : <div class="seg"><button type="button" class="on" aria-current="true" tabindex="-1">{medidas[0]?.rotulo}</button></div>}
          <p class="stamp" id="est-carimbo"></p>
        </div>
        {tema.aviso && <p class="est-aviso"><span class="i" aria-hidden="true">i</span><span>{tema.aviso}</span></p>}
        <div class="grid">
          <div class="est-esq">
            <div class="vh"><div><h2 id="est-vt">{medidas[0]?.titulo}</h2><p id="est-vs">{medidas[0]?.subtitulo}</p></div></div>
            <div class="mtools" id="est-mtools"></div>
            <div id="est-mapa"></div>
            <div id="est-legenda"></div>
            <p class="mm-hint" id="est-dica"></p>
          </div>
          <aside class="side" aria-label="Ficha e ranking">
            <div id="est-ficha" aria-live="polite"></div>
            <div id="est-rank"></div>
            <p class="srcnote" id="est-fonte"></p>
          </aside>
        </div>
        <script type="application/json" id="dados-estado" set:html={JSON.stringify(dados).replace(/</g, '\\u003c')} />
      </>
    )}

    {tema.situacao === 'breve' && (
      <section class="est-empty" aria-labelledby="ee">
        <h2 id="ee">{nomeAba} {N.de}<em class="soon">{site.textos.emBreve}</em></h2>
        <p>{t.breveTexto} <b>{t.fontePrevista}</b> {tema.fonte}.</p>
        {abaAtual?.hrefBrasil && <a class="lnk" href={abaAtual.hrefBrasil}>{preencher(t.enquantoIsso, { aba: nomeAba })}<Fragment set:html={seta} /></a>}
        {comMapa.length > 0 && <div class="est-also"><span>{preencher(t.comMapa, vars)}</span>{comMapa.map((a: any) => <a href={a.href}>{a.nome}</a>)}</div>}
      </section>
    )}
    {tema.situacao === 'sem' && (
      <section class="est-empty" aria-labelledby="ee">
        <h2 id="ee">{preencher(t.semDadoTitulo, { aba: nomeAba })}</h2>
        <p>{tema.motivo}</p>
        {abaAtual?.hrefBrasil && <a class="lnk" href={abaAtual.hrefBrasil}>{preencher(t.verDoBrasil, { aba: nomeAba })}<Fragment set:html={seta} /></a>}
        {comMapa.length > 0 && <div class="est-also"><span>{preencher(t.comMapa, vars)}</span>{comMapa.map((a: any) => <a href={a.href}>{a.nome}</a>)}</div>}
      </section>
    )}
    <p class="sr est-live" aria-live="polite"></p>
    {Object.keys(bandeiras).length > 0 && <p class="est-credito">Bandeiras: Wikimedia Commons, só arquivos com licença livre{bandeiraEstado && <> (a {N.de}: <a href={bandeiraEstado.pagina} rel="noopener">{bandeiraEstado.credito}</a>)</>}; o crédito de cada cidade aparece na ficha.</p>}
    <EspacoAnuncio posicao="abaixo-ranking" />
  </section>
</Base>

<script>
  import './estado-cliente';
</script>

