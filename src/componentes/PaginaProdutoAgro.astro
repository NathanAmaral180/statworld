---
// Página de um item de produção (produto do agro, setor da indústria…) de um país
// (ex.: /economia/agro/soja, /economia/industria/metalurgia). Serve para qualquer país e tema.
import Base from '../layouts/Base.astro';
import Abas from './Abas.astro';
import MapaRanking from './mapa-ranking/MapaRanking.astro';
import { construirVisaoProduto, iconeDoProduto, type Produto } from './mapa-ranking/construir-producao';
import { formatar, preencher } from './mapa-ranking/visao';
import site from '../config/site.json';
import { contextoDoPais } from '../lib/contexto';
import { carregarAgro, temaAgro } from '../lib/agro';

interface Props { pais: any; produtoId: string; teste?: boolean; temaId?: string }
const { pais, produtoId, teste = false, temaId = 'agro' } = Astro.props;
const tema = temaAgro(pais, temaId);

const NIVEL = 'estado';
const { geo, ctx: ctxPais, unidades, mapa } = contextoDoPais(pais, NIVEL);
// Textos do molde ajustados ao tema (ex.: na indústria, "setor" no lugar de "produto").
const ctx = { ...ctxPais, textos: { ...ctxPais.textos, ...(tema.textosMolde ?? {}) } };
const { todos, porFiltro } = carregarAgro(pais, NIVEL, temaId);
const dados = porFiltro.tudo;
const posicao = todos.findIndex((p) => p.id === produtoId);
const produto = todos[posicao] as Produto;

const visoes: Record<string, any> = { valor: construirVisaoProduto('valor', unidades, dados, produto, 'valor', tema, ctx) };
const opcoes = [{ id: 'valor', rotulo: tema.opcoes.valor, visao: 'valor' }];
if (produto.unidadeQuantidade) {
  visoes.quantidade = construirVisaoProduto('quantidade', unidades, dados, produto, 'quantidade', tema, ctx);
  opcoes.push({ id: 'quantidade', rotulo: produto.unidadeQuantidade === 't' ? tema.opcoes.quantidade : tema.opcoes.quantidadeOutra, visao: 'quantidade' });
}

const subtitulo = preencher(tema.textos.subtituloProduto, {
  valor: formatar(produto.valorPais, { formato: 'moeda', casas: 1, compacto: true }, ctx),
  periodo: dados.periodo,
  n: posicao + 1,
  grupoNome: tema.grupos[produto.grupo as keyof typeof tema.grupos],
  fonte: (produto.fontes ?? dados.fontes).map((f) => `${f.nome}, ${f.publicacao.replace(/ \(.*\)$/, '')}`).join('; '),
});
const desenho = tema.icones.icones[iconeDoProduto(tema, produto.id) as keyof typeof tema.icones.icones];
const vars = { pais: pais.nome, dePais: pais.dePais };
const trilha = [...tema.trilha.map((t) => preencher(t, vars)), produto.nome];
const abas = [
  { id: 'dados', nome: tema.textos.abaDados, ativo: false },
  { id: 'ao-vivo', nome: tema.textos.abaAoVivo, ativo: false },
  { id: 'historia', nome: tema.textos.abaHistoria, ativo: false },
];
---
<Base titulo={`${produto.nome} · ${trilha[2]} · ${pais.nome}`} temaAtual="economia" naoIndexar={teste}>
  <section class="conteudo pagina">
    {teste && <p class="aviso-teste">Página de teste: ainda não aparece no menu do site.</p>}
    <p class="trilha">
      <a href={`${pais.caminho}/economia`}>{trilha[0]}</a> / {trilha[1]} / <a href={tema.urlProduto.replace('/{produto}', '')}>{trilha[2]}</a> / {trilha[3]}
    </p>
    <div class="titulo">
      <span class="icone-produto" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={desenho} /></span>
      <h1>{produto.nome}</h1>
    </div>
    <p class="sub">{subtitulo}</p>
    {produto.descricao && <p class="inclui"><strong>{ctx.textos.inclui}:</strong> {produto.descricao}</p>}
    <Abas itens={abas} atual="dados" rotulo={produto.nome} emBreve={site.textos.emBreve} />
    <MapaRanking geo={geo} mapa={mapa} ctx={ctx} opcoes={opcoes} opcaoInicial="valor" visoes={visoes} />
  </section>
</Base>

<style>
  .pagina { padding-top: 40px; padding-bottom: 80px; }
  .aviso-teste { display: inline-block; margin: 0 0 16px; padding: 6px 12px; font-size: 14px; color: var(--sub); background: var(--surf); border: 1px dashed var(--line2); border-radius: 8px; }
  .trilha { margin: 0 0 12px; color: var(--sub); font-size: 17px; }
  .trilha a { color: inherit; }
  .titulo { display: flex; align-items: center; gap: 20px; margin-bottom: 10px; }
  .icone-produto { flex: none; display: grid; place-items: center; width: 72px; height: 72px; border-radius: 16px; background: var(--surf); border: 1px solid var(--line); }
  .icone-produto svg { width: 40px; height: 40px; fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  h1 { margin: 0; font-size: clamp(36px, 5vw, 64px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
  .inclui { margin: -12px 0 24px; color: var(--sub); font-size: 15px; line-height: 1.5; max-width: 80ch; }
  .inclui strong { color: var(--ink); font-weight: 600; }
  .sub { margin: 0 0 24px; color: var(--sub); font-size: 17px; line-height: 1.5; max-width: 80ch; }
</style>
