---
// Abas de navegação (ex.: Visão geral / Agro / Indústria), em grupos com rótulo discreto.
// Visual: design da rodada 4 (design/rodada-4-economia/). Itens inativos aparecem como "em breve".
// Sem quebra de linha: no celular, rolagem lateral, já posicionada na aba ativa.
interface Item { id: string; nome: string; href?: string; ativo: boolean; grupo?: string }
interface Props { itens: Item[]; atual: string; rotulo: string; emBreve: string }
const { itens, atual, rotulo, emBreve } = Astro.props;
// Junta itens seguidos do mesmo grupo.
const blocos: { grupo?: string; itens: Item[] }[] = [];
for (const i of itens) {
  const ultimo = blocos.at(-1);
  if (ultimo && ultimo.grupo === i.grupo) ultimo.itens.push(i);
  else blocos.push({ grupo: i.grupo, itens: [i] });
}
const comGrupos = blocos.some((b) => b.grupo);
// Grupo de um item só com o mesmo nome (ex.: "Visão geral"): o rótulo fica em branco, como no design.
const rotuloDe = (b: { grupo?: string; itens: Item[] }) => (b.itens.length === 1 && b.itens[0].nome === b.grupo ? '' : b.grupo ?? '');
---
<nav class={`abas${comGrupos ? ' com-grupos' : ''}`} aria-label={rotulo}>
  <ul class="abas-in">
    {blocos.map((b) => (
      <li class={`bloco${b.itens.some((i) => i.id === atual) ? ' ativo' : ''}`}>
        {comGrupos && <span class="grupo" aria-hidden="true">{rotuloDe(b) || ' '}</span>}
        <ul class="itens">
          {b.itens.map((i) => (
            <li>
              {i.ativo && i.href ? (
                <a href={i.href} aria-current={i.id === atual ? 'page' : undefined}>{i.nome}</a>
              ) : i.id === atual ? (
                <span class="atual">{i.nome}</span>
              ) : (
                <span class="inativo" aria-disabled="true">{i.nome}<em>{emBreve}</em></span>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</nav>

<script>
  // No celular a barra rola na horizontal: abre já posicionada na aba ativa.
  for (const nav of document.querySelectorAll<HTMLElement>('nav.abas')) {
    const atual = nav.querySelector<HTMLElement>('[aria-current="page"], .atual');
    if (atual && nav.scrollWidth > nav.clientWidth) {
      // Só rola se a aba ativa não estiver inteira à vista.
      const caixa = nav.getBoundingClientRect(), aba = atual.getBoundingClientRect();
      if (aba.right > caixa.right || aba.left < caixa.left) nav.scrollLeft = aba.left - caixa.left - 16;
    }
  }
</script>

<style>
  .abas { margin: 36px 0 28px; overflow-x: auto; scrollbar-width: none; position: relative; }
  .abas::-webkit-scrollbar { display: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  .abas-in { display: flex; align-items: flex-end; width: max-content; min-width: 100%; box-shadow: inset 0 -1px 0 var(--line); }
  .bloco { display: grid; gap: 8px; padding: 0 16px; position: relative; }
  .bloco:first-child { padding-left: 0; }
  .com-grupos .bloco + .bloco::before { content: ""; position: absolute; left: 0; bottom: 14px; height: 16px; width: 1px; background: var(--line2); }
  .grupo { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); font-weight: 600; height: 14px; line-height: 14px; white-space: pre; }
  .bloco.ativo .grupo { color: var(--ink); }
  .itens { display: flex; gap: 18px; }
  a, span.atual, span.inativo { display: flex; align-items: center; gap: 6px; padding: 0 0 12px; font-size: 16px; color: var(--sub); border-bottom: 2px solid transparent; white-space: nowrap; text-decoration: none; }
  a:hover { color: var(--ink); }
  a[aria-current="page"], .atual { color: var(--ink); border-bottom-color: var(--ink); font-weight: 600; }
  .inativo { color: var(--faint); cursor: not-allowed; }
  em { font-style: normal; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; border: 1px dashed var(--line2); border-radius: 4px; padding: 1px 4px; color: var(--faint); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 640px) {
    .abas { margin: 28px -16px 24px; padding: 0 16px; }
    a, span.atual, span.inativo { font-size: 15px; }
  }
</style>
