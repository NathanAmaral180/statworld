---
// Navegação por abas. Visual: design da rodada 4, versão refeita (design/rodada-4-economia/).
// Com grupos (ex.: Economia), são DOIS NÍVEIS:
//   nível 1 = os grupos (Visão geral · Setores · Pessoas e governo · Mundo e mercado);
//   nível 2 = as abas do grupo ativo, logo abaixo (um grupo de uma aba só, como a Visão geral, não tem nível 2).
// Clicar num grupo abre a primeira aba dele que está no ar; grupo sem nenhuma aba no ar fica apagado.
// Nunca quebra linha. No computador, o que não couber vai para "Mais (n)" (a aba ativa nunca vai);
// no celular, o nível 1 usa rótulos curtos e o nível 2 rola na horizontal, já na aba ativa.
// Sem grupos (ex.: Dados · Ao vivo · História), é um nível só.
interface Item { id: string; nome: string; nomeCurto?: string; href?: string; ativo: boolean; grupo?: string; grupoId?: string; grupoCurto?: string }
interface Props { itens: Item[]; atual: string; rotulo: string; emBreve: string }
const { itens, atual, rotulo, emBreve } = Astro.props;

const comGrupos = itens.some((i) => i.grupoId);
const grupos: { id: string; nome: string; curto: string; itens: Item[] }[] = [];
for (const i of itens) {
  const id = i.grupoId ?? '';
  let g = grupos.find((x) => x.id === id);
  if (!g) grupos.push((g = { id, nome: i.grupo ?? '', curto: i.grupoCurto ?? i.grupo ?? '', itens: [] }));
  g.itens.push(i);
}
const grupoAtual = grupos.find((g) => g.itens.some((i) => i.id === atual)) ?? grupos[0];
const nivel1 = grupos.map((g) => ({ ...g, href: g.itens.find((i) => i.ativo && i.href)?.href, on: g === grupoAtual }));
// Grupo de uma aba só com o mesmo nome do grupo (Visão geral) não tem nível 2.
const temNivel2 = comGrupos && !(grupoAtual.itens.length === 1 && grupoAtual.itens[0].nome === grupoAtual.nome);
const nivel2 = comGrupos ? (temNivel2 ? grupoAtual.itens : []) : itens;
const seta = '<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>';
---
<nav class={`nv${comGrupos ? '' : ' um-nivel'}`} aria-label={rotulo}>
  {comGrupos && (
    <div class="nv1">
      <div class="nv-row">
        {nivel1.map((g) =>
          g.on ? (
            <span class="nv-i on" aria-current="true"><span class="lf">{g.nome}</span><span class="ls">{g.curto}</span></span>
          ) : g.href ? (
            <a class="nv-i" href={g.href}><span class="lf">{g.nome}</span><span class="ls">{g.curto}</span></a>
          ) : (
            <span class="nv-i off" aria-disabled="true" title={emBreve}><span class="lf">{g.nome}</span><span class="ls">{g.curto}</span></span>
          )
        )}
      </div>
      <div class="nv-more" hidden><button type="button" class="nv-mb" aria-haspopup="true" aria-expanded="false">Mais<span class="nv-n"></span><Fragment set:html={seta} /></button><div class="nv-menu" role="menu"></div></div>
    </div>
  )}
  {nivel2.length > 0 && (
    <div class="nv2" aria-label={comGrupos ? grupoAtual.nome : rotulo}>
      <div class="nv-row">
        {nivel2.map((i) =>
          i.id === atual ? (
            <span class="nv-i on" aria-current="page">{i.nomeCurto ? <><span class="so-pc">{i.nome}</span><span class="so-cel">{i.nomeCurto}</span></> : i.nome}</span>
          ) : i.ativo && i.href ? (
            <a class="nv-i" href={i.href}>{i.nomeCurto ? <><span class="so-pc">{i.nome}</span><span class="so-cel">{i.nomeCurto}</span></> : i.nome}</a>
          ) : (
            <span class="nv-i off" aria-disabled="true">{i.nomeCurto ? <><span class="so-pc">{i.nome}</span><span class="so-cel">{i.nomeCurto}</span></> : i.nome}<em class="soon">{emBreve}</em></span>
          )
        )}
      </div>
      <div class="nv-more" hidden><button type="button" class="nv-mb" aria-haspopup="true" aria-expanded="false">Mais<span class="nv-n"></span><Fragment set:html={seta} /></button><div class="nv-menu" role="menu"></div></div>
    </div>
  )}
</nav>

<script>
  // "Mais": no computador, as abas que não cabem saem da linha e entram no menu (a ativa nunca sai).
  // No celular (até 640px) não há "Mais": o nível 2 rola na horizontal, já posicionado na aba ativa.
  const celular = () => window.matchMedia('(max-width: 640px)').matches;

  function ajustar(linha: HTMLElement) {
    const row = linha.querySelector<HTMLElement>('.nv-row')!;
    const mais = linha.querySelector<HTMLElement>('.nv-more');
    const menu = linha.querySelector<HTMLElement>('.nv-menu');
    const abas = [...row.children] as HTMLElement[];
    abas.forEach((a) => (a.hidden = false));
    if (!mais || !menu) return;
    mais.hidden = true;
    menu.innerHTML = '';
    if (celular()) {
      const ativa = row.querySelector<HTMLElement>('.on');
      if (ativa && linha.classList.contains('nv2')) {
        const c = row.getBoundingClientRect(), a = ativa.getBoundingClientRect();
        if (a.right > c.right || a.left < c.left) row.scrollLeft += a.left - c.left - 16;
      }
      return;
    }
    if (row.scrollWidth <= row.clientWidth) return;
    mais.hidden = false;
    const fora: HTMLElement[] = [];
    for (let i = abas.length - 1; i >= 0 && row.scrollWidth > row.clientWidth; i--) {
      if (abas[i].classList.contains('on')) continue;
      abas[i].hidden = true;
      fora.unshift(abas[i]);
    }
    for (const a of fora) {
      const copia = a.cloneNode(true) as HTMLElement;
      copia.hidden = false;
      copia.setAttribute('role', 'menuitem');
      menu.appendChild(copia);
    }
    mais.querySelector('.nv-n')!.textContent = ` (${fora.length})`;
  }

  for (const nav of document.querySelectorAll<HTMLElement>('nav.nv')) {
    const linhas = [...nav.querySelectorAll<HTMLElement>('.nv1, .nv2')];
    const tudo = () => linhas.forEach(ajustar);
    tudo();
    new ResizeObserver(tudo).observe(nav);
    nav.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('.nv-mb');
      nav.querySelectorAll<HTMLElement>('.nv-more').forEach((m) => {
        const abrir = !!b && m.contains(b) && !m.classList.contains('open');
        m.classList.toggle('open', abrir);
        m.querySelector('.nv-mb')!.setAttribute('aria-expanded', String(abrir));
      });
    });
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node)) nav.querySelectorAll('.nv-more.open').forEach((m) => m.classList.remove('open'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') nav.querySelectorAll('.nv-more.open').forEach((m) => m.classList.remove('open'));
    });
  }
</script>

<style>
  .nv { margin: 36px 0 28px; position: relative; }
  .nv1, .nv2 { display: flex; align-items: stretch; gap: 24px; position: relative; box-shadow: inset 0 -1px 0 var(--line); }
  .nv-row { display: flex; flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; }
  .nv1 .nv-row { gap: 32px; }
  .nv1 .nv-i { display: flex; align-items: center; gap: 8px; padding: 0 0 12px; font-size: 17px; color: var(--sub); border-bottom: 2px solid transparent; flex: none; text-decoration: none; }
  .nv1 .ls { display: none; }
  .nv2 .nv-row { gap: 28px; }
  .nv2 .nv-i { display: flex; align-items: center; gap: 6px; padding: 12px 0 10px; font-size: 15px; color: var(--sub); border-bottom: 2px solid transparent; flex: none; text-decoration: none; }
  /* Um nível só (sem grupos): abas maiores, como a barra de camadas do design. */
  .um-nivel .nv2 .nv-row { gap: 32px; }
  .um-nivel .nv2 .nv-i { padding: 0 0 12px; font-size: 17px; }
  .um-nivel .nv2 .nv-i.on { border-bottom-color: var(--ink); }
  .nv-i[hidden] { display: none !important; }
  .nv .nv-i:hover { color: var(--ink); }
  .nv .nv-i.on { color: var(--ink); border-bottom-color: var(--ink); font-weight: 600; }
  .nv2 .nv-i.on { border-bottom-color: var(--accent); }
  .nv .nv-i.off { color: var(--faint); cursor: not-allowed; }
  .soon { font-style: normal; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; border: 1px dashed var(--line2); border-radius: 4px; padding: 1px 4px; color: var(--faint); }
  a.nv-i:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Mais */
  .nv-more { position: relative; flex: none; display: flex; }
  .nv-more[hidden] { display: none; }
  .nv-mb { all: unset; cursor: pointer; display: flex; align-items: center; gap: 6px; color: var(--sub); font-size: 15px; border-bottom: 2px solid transparent; }
  .nv1 .nv-mb { font-size: 17px; padding: 0 0 12px; }
  .nv2 .nv-mb { padding: 12px 0 10px; }
  .nv-mb:hover, .nv-more.open .nv-mb { color: var(--ink); }
  .nv-mb:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  .nv-n { color: var(--faint); }
  .nv-menu { display: none; position: absolute; right: 0; top: calc(100% + 6px); z-index: 20; min-width: 240px; background: var(--bg); border: 1px solid var(--line2); border-radius: 10px; padding: 6px; box-shadow: 0 8px 24px rgba(0, 0, 0, .12); }
  .nv-more.open .nv-menu { display: grid; }
  .nv-menu :global(.nv-i) { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 6px; border: 0; font-size: 15px; color: var(--sub); text-decoration: none; white-space: nowrap; }
  .nv-menu :global(a.nv-i:hover) { background: var(--surf); color: var(--ink); }
  .nv-menu :global(.nv-i.off) { color: var(--faint); }
  /* celular: nível 1 com rótulo curto e sempre visível; nível 2 rola */
  @media (max-width: 640px) {
    .nv { margin: 16px -16px 20px; }
    .nv1, .nv2 { padding: 0 16px; }
    .nv1 .nv-row { gap: 20px; }
    .nv1 .nv-i { font-size: 15px; min-height: 44px; box-sizing: border-box; align-items: flex-end; }
    .nv1 .lf { display: none; }
    .nv1 .ls { display: inline; }
    .nv2 .nv-row { overflow-x: auto; scrollbar-width: none; scroll-snap-type: x; margin-right: -16px; padding-right: 16px; }
    .nv2 .nv-row::-webkit-scrollbar { display: none; }
    .nv2 .nv-i { scroll-snap-align: start; min-height: 44px; box-sizing: border-box; font-size: 15px; }
  }
</style>
