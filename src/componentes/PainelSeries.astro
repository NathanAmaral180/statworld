---
// Painel de séries (aba Dinheiro e juros): à direita, a lista de séries (cada uma com selo de frequência,
// último valor e variação); à esquerda, a série escolhida em destaque, com variações e gráfico por período.
// Visual: design da rodada 4. Os números vêm de dados/ (nada escrito aqui). Sem "ao vivo": cada valor mostra a data a que se refere.
import GraficoSerie from './GraficoSerie.astro';
import { formatar, preencher, dataCurta, type Contexto } from './mapa-ranking/visao';

interface Ponto { data: string; valor: number }
interface Serie {
  id: string; nome: string; detalhe: string; unidade: string; casas: number; compacto?: boolean;
  frequencia: string; variacao: 'percentual' | 'pontos'; pontos: Ponto[];
  fontes: { nome: string; publicacao: string; url?: string; dataConsulta?: string }[];
}
interface Props { series: Serie[]; ctx: Contexto; textos: Record<string, string>; inicial?: string }
const { series, ctx, textos, inicial } = Astro.props;

const MES = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(ctx.idioma, { month: 'short', year: 'numeric' }).replace(/[.]/g, '').replace(/ de /g, ' ');
const diaria = (s: Serie) => s.frequencia === 'diário' || s.frequencia === 'por reunião' || s.frequencia === 'semanal';
const nomePonto = (s: Serie, d: string) => (diaria(s) ? dataCurta(d, ctx) : MES(d));
const fmtValor = (s: Serie, v: number) =>
  formatar(v, { formato: s.unidade === '%' ? 'numero' : (s.unidade as any), casas: s.casas, compacto: s.compacto }, ctx) + (s.unidade === '%' ? '%' : '');

// Valor de referência N dias/meses antes do último ponto (o último ponto com data até lá).
function antes(s: Serie, dias: number) {
  const fim = new Date(s.pontos.at(-1)!.data + 'T12:00:00');
  fim.setDate(fim.getDate() - dias);
  const limite = fim.toISOString().slice(0, 10);
  return [...s.pontos].reverse().find((p) => p.data <= limite) ?? null;
}
function variacao(s: Serie, ref: Ponto | null) {
  const u = s.pontos.at(-1)!;
  if (!ref) return null;
  const v = s.variacao === 'percentual' ? (u.valor / ref.valor - 1) * 100 : u.valor - ref.valor;
  const r = Math.round(v * 100) / 100;
  const num = formatar(r, { formato: 'numero', casas: 2, sinal: true }, ctx);
  const texto = r === 0 ? textos.semMudanca : s.variacao === 'percentual' ? `${num}%` : preencher(Math.abs(r) === 1 ? textos.ponto : textos.pontos, { v: num });
  return { texto, dir: r > 0 ? 'u' : r < 0 ? 'n' : 'z', seta: r > 0 ? '▲' : r < 0 ? '▼' : '' };
}

const PERIODOS_DIA: [string, number][] = [[textos.p1m, 31], [textos.p6m, 183], [textos.p1a, 366], [textos.p5a, 99999]];
const PERIODOS_MES: [string, number][] = [[textos.p1a, 366], [textos.p5a, 1830], [textos.p10a, 99999]];

const blocos = series.map((s) => {
  const u = s.pontos.at(-1)!;
  const dia = diaria(s);
  const comparacoes = dia
    ? [[textos.dia, variacao(s, s.pontos.at(-2) ?? null)], [textos.mes, variacao(s, antes(s, 30))], [textos.doze, variacao(s, antes(s, 365))]]
    : [[textos.mesAnterior, variacao(s, s.pontos.at(-2) ?? null)], [textos.doze, variacao(s, antes(s, 365))]];
  const periodos = (dia ? PERIODOS_DIA : PERIODOS_MES).map(([rotulo, dias], k) => {
    const ref = antes(s, dias);
    const pts = ref ? s.pontos.filter((p) => p.data >= ref.data) : s.pontos;
    return { id: `${s.id}-${k}`, rotulo, pontos: pts.map((p) => ({ nome: nomePonto(s, p.data), valor: p.valor })) };
  });
  const padrao = dia ? 2 : 1; // abre em "1 ano" (diárias) ou "5 anos" (mensais)
  const f = s.fontes[0];
  return {
    s, u, dia, comparacoes, periodos, padrao,
    valor: fmtValor(s, u.valor),
    quando: dia ? dataCurta(u.data, ctx) : MES(u.data),
    resumoVar: comparacoes[0][1] as ReturnType<typeof variacao>,
    carimbo: `${f.nome}, ${f.publicacao}${f.dataConsulta ? ` · ${preencher(textos.consultadoEm, { data: dataCurta(f.dataConsulta, ctx) })}` : ''}`,
  };
});
const ativa = inicial ?? series[0].id;
---
<div class="ps" data-painel-series>
  <div class="ps-destaque">
    {blocos.map((b) => (
      <section class="ps-bloco" data-serie={b.s.id} hidden={b.s.id !== ativa}>
        <p class="ps-nome"><strong>{b.s.nome}</strong> · {b.s.detalhe} <span class="selo">{b.s.frequencia}</span></p>
        <p class="ps-valor">{b.valor}</p>
        <p class="ps-quando">{b.dia ? textos.valorDe : textos.mesDe} {b.quando}</p>
        <dl class="ps-var">
          {b.comparacoes.map(([rotulo, v]: any) => (
            <div><dt>{rotulo}</dt><dd class={v ? `d ${v.dir}` : 'd z'}>{v ? `${v.seta} ${v.texto}`.trim() : textos.semDado}</dd></div>
          ))}
        </dl>
        <div class="ps-periodos" role="group" aria-label={textos.periodo}>
          {b.periodos.map((p, k) => <button type="button" data-periodo={p.id} aria-pressed={String(k === b.padrao)}>{p.rotulo}</button>)}
        </div>
        {b.periodos.map((p, k) => (
          <div class="ps-grafico" data-grafico-de={p.id} hidden={k !== b.padrao}>
            <GraficoSerie titulo="" series={[{ formato: b.s.unidade === '%' ? 'numero' : (b.s.unidade as any), casas: b.s.unidade === '%' ? 2 : b.s.casas, pontos: p.pontos }]} ctx={ctx} />
          </div>
        ))}
        <p class="ps-carimbo"><span class="selo">{b.s.frequencia}</span><a href={b.s.fontes[0].url} rel="noopener">{b.carimbo}</a></p>
      </section>
    ))}
  </div>
  <aside class="ps-lista" aria-label={textos.series}>
    <p class="ps-lista-titulo">{textos.series}</p>
    {blocos.map((b) => (
      <button type="button" class="ps-item" data-escolher={b.s.id} aria-pressed={String(b.s.id === ativa)}>
        <span class="i-topo"><span class="i-nome">{b.s.nome}</span><span class="selo">{b.s.frequencia}</span></span>
        <span class="i-valor">{b.valor}</span>
        <span class={`i-var ${b.resumoVar?.dir ?? 'z'}`}>{b.resumoVar ? `${b.resumoVar.seta} ${b.resumoVar.texto}`.trim() : ''} <em>· {b.quando}</em></span>
      </button>
    ))}
  </aside>
</div>

<script>
  for (const painel of document.querySelectorAll<HTMLElement>('[data-painel-series]')) {
    painel.addEventListener('click', (e) => {
      const alvo = e.target as Element;
      const item = alvo.closest<HTMLElement>('[data-escolher]');
      if (item) {
        const id = item.dataset.escolher!;
        painel.querySelectorAll<HTMLElement>('[data-serie]').forEach((b) => { b.hidden = b.dataset.serie !== id; });
        painel.querySelectorAll<HTMLElement>('[data-escolher]').forEach((b) => b.setAttribute('aria-pressed', String(b === item)));
        return;
      }
      const per = alvo.closest<HTMLElement>('[data-periodo]');
      if (per) {
        const bloco = per.closest<HTMLElement>('.ps-bloco')!;
        bloco.querySelectorAll<HTMLElement>('[data-periodo]').forEach((b) => b.setAttribute('aria-pressed', String(b === per)));
        bloco.querySelectorAll<HTMLElement>('[data-grafico-de]').forEach((g) => { g.hidden = g.dataset.graficoDe !== per.dataset.periodo; });
      }
    });
  }
</script>

<style>
  .ps { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; align-items: start; }
  .ps p { margin: 0; }
  .ps-bloco[hidden], .ps-grafico[hidden] { display: none; }
  .ps-nome { font-size: 15px; color: var(--sub); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .ps-nome strong { color: var(--ink); font-weight: 600; }
  .ps-valor { font-size: 64px; font-weight: 600; letter-spacing: -.03em; line-height: 1; margin-top: 12px !important; font-variant-numeric: tabular-nums; }
  .ps-quando { font-size: 14px; color: var(--sub); margin-top: 8px !important; }
  .ps-var { display: flex; flex-wrap: wrap; margin: 20px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ps-var div { padding: 12px 28px 12px 0; margin-right: 28px; border-right: 1px solid var(--line); display: grid; gap: 2px; }
  .ps-var div:last-child { border-right: 0; }
  .ps-var dt { font-size: 13px; color: var(--sub); }
  .ps-var dd { margin: 0; font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .d.u { color: var(--up); } .d.n { color: var(--down); } .d.z { color: var(--sub); }
  .ps-periodos { display: inline-flex; gap: 2px; padding: 4px; background: var(--surf); border-radius: 10px; margin-top: 24px; }
  .ps-periodos button { border: 0; background: transparent; height: 32px; padding: 0 12px; border-radius: 7px; font: inherit; font-size: 14px; color: var(--sub); cursor: pointer; }
  .ps-periodos button[aria-pressed="true"] { background: var(--bg); color: var(--ink); font-weight: 500; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 0 0 1px var(--line); }
  .ps-grafico :global(.gs-fig) { margin-top: 8px; }
  .ps-carimbo { display: flex; gap: 6px 8px; align-items: center; flex-wrap: wrap; font-size: 12px; color: var(--faint); margin-top: 12px !important; }
  .ps-carimbo a { color: inherit; text-decoration: none; }
  .ps-carimbo a:hover { color: var(--ink); text-decoration: underline; }
  .selo { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--sub); border: 1px solid var(--line2); border-radius: 4px; padding: 2px 6px; line-height: 1.3; white-space: nowrap; }
  .ps-lista { display: grid; gap: 8px; }
  .ps-lista-titulo { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--sub); font-weight: 600; }
  .ps-item { display: grid; gap: 4px; text-align: left; font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; cursor: pointer; }
  .ps-item:hover { border-color: var(--line2); }
  .ps-item[aria-pressed="true"] { background: var(--surf); border-color: var(--ink); }
  .ps-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .i-topo { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .i-nome { font-size: 15px; font-weight: 600; }
  .i-valor { font-size: 24px; font-weight: 600; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .i-var { font-size: 13px; }
  .i-var.u { color: var(--up); } .i-var.n { color: var(--down); } .i-var.z { color: var(--sub); }
  .i-var em { font-style: normal; color: var(--faint); }
  @media (max-width: 1100px) { .ps { grid-template-columns: 1fr; gap: 32px; } .ps-lista { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); } .ps-lista-titulo { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .ps-valor { font-size: 44px; } .ps-var div { padding: 10px 16px 10px 0; margin-right: 16px; } .ps-var dd { font-size: 17px; } }
</style>
