---
// Faixa "<Assunto> hoje" de uma aba (fica abaixo do mapa e do ranking): 3 números nacionais recentes, cada um com
// selo de frequência, fonte e data. Visual: design da rodada 4 (design/rodada-4-economia/).
// Os números vêm de um arquivo em dados/ (nada escrito aqui).
import { formatar, dataCurta, type Contexto } from './mapa-ranking/visao';

interface Indicador {
  id: string; rotulo: string; frequencia: string; valor: number | null; formato: any; casas: number; compacto?: boolean;
  observacao?: string; fonteCurta?: string;
  fontes: { nome: string; publicacao: string; url?: string; dataDivulgacao?: string | null }[];
}
interface Props { rotulo: string; descricao?: string; indicadores: Indicador[]; ctx: Contexto }
const { rotulo, descricao, indicadores, ctx } = Astro.props;

const itens = indicadores.map((i) => {
  const f = i.fontes[0];
  return {
    ...i,
    texto: formatar(i.valor, { formato: i.formato, casas: i.casas, compacto: i.compacto }, ctx),
    fonte: (i.fonteCurta ?? f.nome) + (f.dataDivulgacao ? ` · ${dataCurta(f.dataDivulgacao, ctx)}` : ''),
    titulo: `${f.nome}, ${f.publicacao}`,
    url: f.url,
  };
});
---
<section class="hoje" aria-label={rotulo}>
  <div class="hoje-cab">{rotulo}{descricao && <span>{descricao}</span>}</div>
  {itens.map((k) => (
    <div class="kpi">
      <b class={k.valor === null ? 'sem' : undefined}>{k.texto}</b>
      <div class="lbl">{k.rotulo}</div>
      <div class="carimbo">
        {k.observacao && <span class="obs">{k.observacao}</span>}
        <span class="freq">{k.frequencia}</span>
        {k.url ? <a href={k.url} title={k.titulo} rel="noopener">{k.fonte}</a> : <span title={k.titulo}>{k.fonte}</span>}
      </div>
    </div>
  ))}
</section>

<style>
  .hoje { margin-top: 64px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 200px repeat(3, minmax(0, 1fr)); align-items: stretch; }
  .hoje-cab { padding: 18px 0; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--sub); font-weight: 600; display: flex; flex-direction: column; gap: 4px; }
  .hoje-cab span { text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--faint); font-size: 13px; }
  .kpi { padding: 16px 24px; border-left: 1px solid var(--line); display: grid; gap: 4px; align-content: start; min-width: 0; }
  .kpi b { font-size: 26px; font-weight: 600; letter-spacing: -.01em; }
  .kpi b.sem { color: var(--faint); font-size: 20px; }
  .lbl { font-size: 14px; color: var(--ink); text-wrap: pretty; }
  .carimbo { display: flex; gap: 6px 8px; align-items: center; flex-wrap: wrap; font-size: 12px; color: var(--faint); line-height: 1.4; }
  .carimbo a { color: inherit; text-decoration: none; }
  .carimbo a:hover { color: var(--ink); text-decoration: underline; }
  .freq, .obs { display: inline-flex; align-items: center; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--sub); border-radius: 4px; padding: 2px 6px; line-height: 1.3; white-space: nowrap; }
  .freq { border: 1px solid var(--line2); }
  .obs { background: var(--track); }
  @media (max-width: 1100px) {
    .hoje { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hoje-cab { grid-column: 1 / -1; padding-bottom: 0; }
    .kpi:nth-child(2) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 640px) {
    .hoje { grid-template-columns: minmax(0, 1fr); margin-top: 40px; }
    .hoje-cab { padding: 14px 0 6px; }
    .kpi, .kpi:nth-child(2) { border-left: 0; padding: 12px 0; border-top: 1px solid var(--line); }
    .kpi b { font-size: 22px; }
  }
</style>
