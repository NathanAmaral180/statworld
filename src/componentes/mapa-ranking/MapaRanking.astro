---
// Molde "mapa + ranking + ficha". Recebe "visões" prontas (ver visao.ts) e só desenha.
// Nada aqui é exclusivo de um país ou de um tema.
import { htmlRanking, htmlFicha, htmlLegenda, htmlChip, preencher, type Visao, type Contexto, type Unidade } from './visao';

export interface Opcao {
  id: string;
  rotulo: string;
  visao?: string; // chave em `visoes`
  lista?: { rotulo: string; itens: { id: string; rotulo: string; url: string; grupo?: string; destaque?: boolean; iconeSvg?: string }[]; padrao: string };
  filtros?: { rotulo: string; itens: { id: string; rotulo: string; visao: string }[]; padrao: string };
}

interface Props {
  geo: { largura: number; altura: number; unidades: (Unidade & { caminho: string; centro: [number, number] })[] };
  mapa: { margem: { cima: number; direita: number; baixo: number; esquerda: number }; chamadas: Record<string, [number, number]> };
  ctx: Contexto;
  opcoes: Opcao[];
  opcaoInicial: string;
  visoes: Record<string, Visao>; // chave: id da visão, ou "lista:<item>" para itens de lista
}
const { geo, mapa, ctx, opcoes, opcaoInicial, visoes } = Astro.props;

const chaveDe = (o: Opcao) =>
  o.lista ? `lista:${o.lista.padrao}` : o.filtros ? o.filtros.itens.find((i) => i.id === o.filtros!.padrao)!.visao : o.visao!;
const opcao = opcoes.find((o) => o.id === opcaoInicial) ?? opcoes[0];
const visao = visoes[chaveDe(opcao)];
if (!visao) throw new Error(`Visão inicial não encontrada: ${chaveDe(opcao)}`);
const ativo = visao.linhas[0].uf;
const listaOpcao = opcoes.find((o) => o.lista);
const filtroOpcao = opcoes.find((o) => o.filtros);
// Itens da lista agrupados (ex.: Lavouras / Pecuária), na ordem em que aparecem.
const gruposLista = listaOpcao
  ? [...new Set(listaOpcao.lista!.itens.map((i) => i.grupo ?? ''))].map((g) => ({ g, itens: listaOpcao.lista!.itens.filter((i) => (i.grupo ?? '') === g) }))
  : [];

const { margem, chamadas } = mapa;
const viewBox = `${-margem.esquerda} ${-margem.cima} ${geo.largura + margem.esquerda + margem.direita} ${geo.altura + margem.cima + margem.baixo}`;
// O navegador não precisa dos desenhos dos ícones da lista (já estão no HTML).
const opcoesCliente = opcoes.map((o) => (o.lista ? { ...o, lista: { ...o.lista, itens: o.lista.itens.map(({ iconeSvg, ...resto }) => resto) } } : o));
const dadosCliente = { opcoes: opcoesCliente, opcaoInicial: opcao.id, visoes };
---
<div class={`mr${visao.icones ? ' com-icones' : ''}`} data-mapa-ranking data-matiz={visao.matiz} style={visao.matiz ? `--matiz: var(--${visao.matiz})` : undefined}>
  {(opcoes.length > 1 || listaOpcao || filtroOpcao) && (
    <div class="mr-controles">
      {opcoes.length > 1 && (
        <div class="mr-medidas" role="group" aria-label={ctx.textos.escolhaMedida}>
          {opcoes.map((o) => (
            <button type="button" data-opcao={o.id} aria-pressed={String(o.id === opcao.id)}>{o.rotulo}</button>
          ))}
        </div>
      )}
      {filtroOpcao && (
        <div class="mr-filtros" data-filtros-de={filtroOpcao.id} hidden={opcao.id !== filtroOpcao.id}>
          <span>{filtroOpcao.filtros!.rotulo}</span>
          <div class="mr-medidas mr-pequeno" role="group" aria-label={filtroOpcao.filtros!.rotulo}>
            {filtroOpcao.filtros!.itens.map((i) => (
              <button type="button" data-filtro={i.id} aria-pressed={String(i.id === filtroOpcao.filtros!.padrao)}>{i.rotulo}</button>
            ))}
          </div>
        </div>
      )}
      {listaOpcao && listaOpcao.lista!.itens.some((i) => i.destaque) && (
        <div class="mr-atalhos" data-atalhos-de={listaOpcao.id} hidden={opcao.id !== listaOpcao.id} role="group" aria-label={listaOpcao.lista!.rotulo}>
          {listaOpcao.lista!.itens.filter((i) => i.destaque).map((i) => (
            <button type="button" data-produto={i.id} aria-pressed={String(i.id === listaOpcao.lista!.padrao)}>
              {i.iconeSvg && <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={i.iconeSvg} />}{i.rotulo}
            </button>
          ))}
        </div>
      )}
      {listaOpcao && (
        <div class="mr-mais" data-mais={listaOpcao.id} data-atual={listaOpcao.lista!.padrao} hidden={opcao.id !== listaOpcao.id}>
          <button type="button" class="mr-mais-botao" aria-haspopup="listbox" aria-expanded="false" aria-controls={`mr-mais-${listaOpcao.id}`} aria-pressed="false">
            <span class="mr-mais-icone" aria-hidden="true"></span><span class="mr-mais-rotulo">{ctx.textos.outrosProdutosBotao}</span>
            <svg class="ic seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          <div class="mr-mais-painel" hidden>
            <input type="search" class="mr-mais-busca" placeholder={ctx.textos.buscarProduto} aria-label={ctx.textos.buscarProduto} autocomplete="off" />
            <ul role="listbox" id={`mr-mais-${listaOpcao.id}`} aria-label={listaOpcao.lista!.rotulo}>
              {gruposLista.map(({ g, itens }) => (
                <>
                  {g && <li class="mr-mais-grupo" role="presentation">{g}</li>}
                  {itens.map((i) => (
                    <li role="option" tabindex="-1" data-valor={i.id} data-url={i.url} data-busca={i.rotulo.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()} aria-selected={String(i.id === listaOpcao.lista!.padrao)}>
                      {i.iconeSvg ? <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={i.iconeSvg} /> : <span class="ic-vazio" aria-hidden="true"></span>}
                      <span>{i.rotulo}</span>
                    </li>
                  ))}
                </>
              ))}
            </ul>
            <p class="mr-mais-vazio" hidden>{ctx.textos.nenhumProduto}</p>
          </div>
        </div>
      )}
    </div>
  )}

  <div class="mr-grade">
    <figure class="mr-mapa">
      <svg viewBox={viewBox} role="img" aria-label={preencher(ctx.textos.mapaDescricao, { titulo: visao.titulo, nivel: ctx.nivelSingular })}>
        <defs>
          <pattern id="mr-hachura" patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(45)">
            <rect width="7" height="7" class="hachura-fundo" />
            <line x1="0" y1="0" x2="0" y2="7" class="hachura-linha" />
          </pattern>
        </defs>
        <g class="mr-unidades">
          {geo.unidades.map((u) => (
            <path class="uf" id={`mr-uf-${u.sigla}`} d={u.caminho} data-uf={u.sigla} data-classe={visao.classes[u.sigla]}><title>{u.nome}</title></path>
          ))}
        </g>
        <path class="mr-destaque" d={geo.unidades.find((u) => u.sigla === ativo)?.caminho} />
        <g class="mr-icones" aria-hidden="true">
          {geo.unidades.map((u) => {
            const ch = chamadas[u.sigla];
            const [x, y] = ch ? [ch[0] + 14, ch[1]] : [u.centro[0], u.centro[1] - 14];
            return <g class={`chip-uf${ch ? ' de-chamada' : ''}`} data-uf={u.sigla} transform={`translate(${x} ${y})`}
              set:html={htmlChip(visao.svgs, visao.icones?.[u.sigla])} />;
          })}
        </g>
        <g class="mr-rotulos" aria-hidden="true">
          {geo.unidades.map((u) => {
            const ch = chamadas[u.sigla];
            return ch ? (
              <g class="chamada" data-uf={u.sigla}>
                <line x1={u.centro[0]} y1={u.centro[1]} x2={ch[0] - 14} y2={ch[1]} />
                <circle cx={u.centro[0]} cy={u.centro[1]} r="2.6" />
                <text x={ch[0]} y={ch[1]} text-anchor="start" dominant-baseline="central">{u.sigla}</text>
              </g>
            ) : (
              <text class="rotulo" data-uf={u.sigla} data-classe={visao.classes[u.sigla]} x={u.centro[0]} y={u.centro[1]}
                text-anchor="middle" dominant-baseline="central">{u.sigla}</text>
            );
          })}
        </g>
      </svg>
      <ul class="mr-legenda" set:html={htmlLegenda(visao)} />
    </figure>

    <div class="mr-lado">
      <div class="mr-ficha" aria-live="polite" set:html={htmlFicha(visao.fichas[ativo], visao.svgs)} />
      <div class="mr-tabela">
        <div class="mr-cab"><span>{ctx.nivelSingular}</span><span class="mr-cab-medida">{visao.titulo}</span></div>
        <ol class="mr-ranking" set:html={htmlRanking(visao, ativo)} />
        <p class="mr-dica">{preencher(ctx.textos.rankingDica, { nivel: ctx.nivelSingular })}</p>
      </div>
      <p class="mr-fonte" set:html={visao.fonte} />
    </div>
  </div>

  <script type="application/json" class="mr-dados" set:html={JSON.stringify(dadosCliente).replace(/</g, '\\u003c')} />
</div>

<script>
  import { htmlRanking, htmlFicha, htmlLegenda, htmlChip, type Visao } from './visao';

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-mapa-ranking]')) {
    const d = JSON.parse(raiz.querySelector('.mr-dados')!.textContent!);
    const cache: Record<string, Visao> = { ...d.visoes };
    let opcaoId: string = d.opcaoInicial;
    let visao: Visao;
    let fixado: string | null = null;
    let previa: string | null = null;

    const $ = <T extends Element = HTMLElement>(s: string) => raiz.querySelector<T>(s);
    const ficha = $('.mr-ficha')!;
    const ranking = $('.mr-ranking')!;
    const destaque = $<SVGPathElement>('.mr-destaque')!;
    // Escolha de produto: botões de atalho + botão "Outros produtos ▾" que abre a lista com ícones.
    const mais = $<HTMLElement>('[data-mais]');
    const maisBotao = mais?.querySelector<HTMLButtonElement>('.mr-mais-botao');
    const maisPainel = mais?.querySelector<HTMLElement>('.mr-mais-painel');
    const maisBusca = mais?.querySelector<HTMLInputElement>('.mr-mais-busca');
    const itensLista = () => [...(mais?.querySelectorAll<HTMLElement>('[role="option"]') ?? [])];
    let produtoAtual = mais?.dataset.atual ?? '';

    function marcarProduto() {
      const atalhos = [...raiz.querySelectorAll<HTMLElement>('[data-produto]')];
      atalhos.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.produto === produtoAtual)));
      itensLista().forEach((li) => li.setAttribute('aria-selected', String(li.dataset.valor === produtoAtual)));
      if (!maisBotao) return;
      const ehAtalho = atalhos.some((b) => b.dataset.produto === produtoAtual);
      const item = itensLista().find((li) => li.dataset.valor === produtoAtual);
      // Produto fora dos atalhos: o botão passa a mostrar o nome e o ícone dele.
      maisBotao.setAttribute('aria-pressed', String(!ehAtalho));
      maisBotao.querySelector('.mr-mais-rotulo')!.textContent = !ehAtalho && item ? item.innerText.trim() : maisBotao.dataset.rotuloPadrao!;
      maisBotao.querySelector('.mr-mais-icone')!.innerHTML = !ehAtalho && item ? (item.querySelector('svg.ic')?.outerHTML ?? '') : '';
    }
    function abrirLista() {
      if (!maisPainel || !maisBotao) return;
      maisPainel.hidden = false;
      maisBotao.setAttribute('aria-expanded', 'true');
      if (maisBusca) { maisBusca.value = ''; filtrarLista(''); maisBusca.focus(); }
    }
    function fecharLista(devolverFoco = false) {
      if (!maisPainel || maisPainel.hidden) return;
      maisPainel.hidden = true;
      maisBotao?.setAttribute('aria-expanded', 'false');
      if (devolverFoco) maisBotao?.focus();
    }
    function filtrarLista(texto: string) {
      const t = texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
      let algum = false;
      itensLista().forEach((li) => { const ok = !t || li.dataset.busca!.includes(t); li.hidden = !ok; algum ||= ok; });
      mais?.querySelectorAll<HTMLElement>('.mr-mais-grupo').forEach((g) => { g.hidden = !!t; });
      const vazio = mais?.querySelector<HTMLElement>('.mr-mais-vazio');
      if (vazio) vazio.hidden = algum;
    }
    function escolherProduto(id: string) {
      produtoAtual = id;
      fecharLista(true);
      escolher(opcaoId);
    }
    if (maisBotao) {
      maisBotao.dataset.rotuloPadrao = maisBotao.querySelector('.mr-mais-rotulo')!.textContent!;
      maisBotao.addEventListener('click', () => (maisPainel!.hidden ? abrirLista() : fecharLista()));
      maisBusca?.addEventListener('input', () => filtrarLista(maisBusca.value));
      mais!.addEventListener('click', (e) => {
        const li = (e.target as Element).closest<HTMLElement>('[role="option"]');
        if (li) escolherProduto(li.dataset.valor!);
      });
      mais!.addEventListener('keydown', (e) => {
        const visiveis = itensLista().filter((li) => !li.hidden);
        const i = visiveis.indexOf(document.activeElement as HTMLElement);
        if (e.key === 'Escape') { fecharLista(true); e.preventDefault(); }
        else if (e.key === 'ArrowDown') { (visiveis[Math.min(visiveis.length - 1, i + 1)] ?? visiveis[0])?.focus(); e.preventDefault(); }
        else if (e.key === 'ArrowUp') { if (i <= 0) maisBusca?.focus(); else visiveis[i - 1].focus(); e.preventDefault(); }
        else if (e.key === 'Enter' && i >= 0) { escolherProduto(visiveis[i].dataset.valor!); e.preventDefault(); }
        else if (e.key === 'Enter' && document.activeElement === maisBusca && visiveis.length) { escolherProduto(visiveis[0].dataset.valor!); e.preventDefault(); }
      });
      document.addEventListener('click', (e) => { if (!mais!.contains(e.target as Node)) fecharLista(); });
      marcarProduto();
    }
    const filtroEscolhido: Record<string, string> = Object.fromEntries(
      d.opcoes.filter((o: any) => o.filtros).map((o: any) => [o.id, o.filtros.padrao])
    );

    async function carregar(chave: string, url?: string): Promise<Visao> {
      if (!cache[chave]) {
        raiz.classList.add('carregando');
        try {
          const r = await fetch(url!);
          if (!r.ok) throw new Error(String(r.status));
          cache[chave] = await r.json();
        } finally {
          raiz.classList.remove('carregando');
        }
      }
      return cache[chave];
    }

    async function escolher(id: string) {
      opcaoId = id;
      const o = d.opcoes.find((x: any) => x.id === id);
      raiz.querySelectorAll('[data-opcao]').forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-opcao') === id)));
      if (mais) mais.hidden = !o.lista;
      if (!o.lista) fecharLista();
      raiz.querySelectorAll<HTMLElement>('[data-atalhos-de]').forEach((el) => { el.hidden = !o.lista; });
      marcarProduto();
      raiz.querySelectorAll<HTMLElement>('[data-filtros-de]').forEach((el) => { el.hidden = el.dataset.filtrosDe !== id; });
      if (o.filtros) {
        const f = filtroEscolhido[id];
        raiz.querySelectorAll('[data-filtro]').forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-filtro') === f)));
        aplicar(cache[o.filtros.itens.find((i: any) => i.id === f).visao]);
      } else if (o.lista) {
        const item = itensLista().find((li) => li.dataset.valor === produtoAtual)!;
        aplicar(await carregar(`lista:${produtoAtual}`, item.dataset.url));
      } else {
        aplicar(cache[o.visao]);
      }
    }

    function aplicar(v: Visao) {
      visao = v;
      raiz.querySelectorAll<SVGElement>('.uf, .rotulo').forEach((el) => { el.dataset.classe = v.classes[el.dataset.uf!]; });
      raiz.classList.toggle('com-icones', !!v.icones);
      if (v.matiz) { raiz.dataset.matiz = v.matiz; raiz.style.setProperty('--matiz', `var(--${v.matiz})`); }
      else { delete raiz.dataset.matiz; raiz.style.removeProperty('--matiz'); }
      raiz.querySelectorAll<SVGGElement>('.chip-uf').forEach((g) => { g.innerHTML = htmlChip(v.svgs, v.icones?.[g.dataset.uf!]); });
      $('.mr-legenda')!.innerHTML = htmlLegenda(v);
      $('.mr-cab-medida')!.textContent = v.titulo;
      $('.mr-fonte')!.innerHTML = v.fonte;
      ranking.innerHTML = htmlRanking(v, null);
      destacar();
    }

    function destacar() {
      const sigla = previa ?? fixado ?? visao.linhas[0].uf;
      ficha.innerHTML = htmlFicha(visao.fichas[sigla], visao.svgs);
      const caminho = raiz.querySelector(`#mr-uf-${sigla}`)?.getAttribute('d');
      if (caminho) destaque.setAttribute('d', caminho);
      ranking.querySelectorAll<HTMLElement>('.linha').forEach((b) => {
        b.classList.toggle('ativa', b.dataset.uf === sigla);
        b.setAttribute('aria-pressed', String(b.dataset.uf === fixado));
      });
    }

    const ufDe = (alvo: EventTarget | null) => (alvo as Element | null)?.closest?.<HTMLElement | SVGElement>('[data-uf]')?.dataset.uf ?? null;

    // Passar o mouse = prévia; clicar = fixa (clicar de novo solta).
    raiz.addEventListener('pointerover', (e) => {
      const uf = ufDe(e.target);
      if (uf && uf !== previa) { previa = uf; destacar(); }
    });
    raiz.addEventListener('pointerout', (e) => {
      if (previa && !ufDe(e.relatedTarget)) { previa = null; destacar(); }
    });
    raiz.addEventListener('click', (e) => {
      const botao = (e.target as Element).closest<HTMLElement>('[data-opcao]');
      if (botao) { escolher(botao.dataset.opcao!); return; }
      const atalho = (e.target as Element).closest<HTMLElement>('[data-produto]');
      if (atalho) { produtoAtual = atalho.dataset.produto!; escolher(opcaoId); return; }
      const filtro = (e.target as Element).closest<HTMLElement>('[data-filtro]');
      if (filtro) { filtroEscolhido[opcaoId] = filtro.dataset.filtro!; escolher(opcaoId); return; }
      const uf = ufDe(e.target);
      if (uf) { fixado = fixado === uf ? null : uf; destacar(); }
    });
    // Teclado: foco numa linha = prévia; setas sobem/descem.
    ranking.addEventListener('focusin', (e) => { previa = ufDe(e.target); destacar(); });
    ranking.addEventListener('focusout', (e) => { if (!ranking.contains(e.relatedTarget as Node)) { previa = null; destacar(); } });
    ranking.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const botoes = [...ranking.querySelectorAll<HTMLElement>('.linha')];
      const i = botoes.indexOf(document.activeElement as HTMLElement);
      botoes[Math.max(0, Math.min(botoes.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)))]?.focus();
      e.preventDefault();
    });

    escolher(opcaoId);
  }
</script>

<style>
  .mr { --mr-lado: 560px; }
  .mr.carregando .mr-grade { opacity: .55; transition: opacity .2s; }

  /* Controles */
  .mr-controles { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-bottom: 28px; }
  .mr-medidas { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--surf); border: 1px solid var(--line); border-radius: 12px; }
  .mr-medidas button { font: inherit; font-size: 16px; color: var(--sub); background: transparent; border: 0; border-radius: 9px; padding: 10px 18px; cursor: pointer; }
  .mr-medidas button:hover { color: var(--ink); }
  .mr-medidas button[aria-pressed="true"] { background: var(--bg); color: var(--ink); font-weight: 600; box-shadow: 0 0 0 1px var(--line), 0 1px 3px var(--line); }
  .mr-medidas button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mr-filtros { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; color: var(--sub); }
  .mr-filtros[hidden] { display: none; }
  .mr-pequeno button { font-size: 14px; padding: 7px 14px; }
  .mr-atalhos { display: flex; flex-wrap: wrap; gap: 8px; }
  .mr-atalhos[hidden] { display: none; }
  .mr-atalhos button { font: inherit; font-size: 15px; display: inline-flex; align-items: center; color: var(--ink); background: var(--bg); border: 1px solid var(--line2); border-radius: 8px; padding: 7px 12px; cursor: pointer; }
  .mr-atalhos button:hover { background: var(--surf); }
  .mr-atalhos button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .mr-atalhos button[aria-pressed="true"] :global(.ic) { color: var(--bg); }
  .mr-atalhos button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* "Outros produtos ▾": mesmo visual dos botões de atalho; abre uma lista com ícones e busca */
  .mr-mais { position: relative; }
  .mr-mais[hidden] { display: none; }
  .mr-mais-botao { font: inherit; font-size: 15px; display: inline-flex; align-items: center; gap: 0; color: var(--ink); background: var(--bg); border: 1px solid var(--line2); border-radius: 8px; padding: 7px 10px 7px 12px; cursor: pointer; }
  .mr-mais-botao:hover { background: var(--surf); }
  .mr-mais-botao[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .mr-mais-botao[aria-pressed="true"] :global(.ic) { color: var(--bg); }
  .mr-mais-botao:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mr-mais-botao .seta { margin: 0 0 0 6px; width: 16px; height: 16px; }
  .mr-mais-icone:empty { display: none; }
  .mr-mais-painel { position: absolute; z-index: 30; top: calc(100% + 6px); left: 0; width: 300px; max-width: calc(100vw - 32px); background: var(--bg); border: 1px solid var(--line2); border-radius: 12px; box-shadow: 0 12px 32px rgba(0, 0, 0, .16); padding: 8px; }
  .mr-mais-painel[hidden] { display: none; }
