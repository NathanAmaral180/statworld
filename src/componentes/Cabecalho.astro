---
// Cabeçalho do site: logo, temas (Economia, Saúde...) e botão de tema claro/escuro.
// Os temas vêm de src/config/site.json — nada escrito à mão aqui.
import site from '../config/site.json';

interface Props { temaAtual?: string }
const { temaAtual = 'economia' } = Astro.props;
---
<header class="cabecalho">
  <div class="conteudo barra">
    <a class="logo" href="/" aria-label={`${site.nome}, página inicial`}>
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <rect x="0" y="0" width="10" height="10" fill="var(--rampa-3)" />
        <rect x="12" y="0" width="10" height="10" fill="var(--rampa-5)" />
        <rect x="0" y="12" width="10" height="10" fill="var(--rampa-4)" />
        <rect x="12" y="12" width="10" height="10" fill="var(--rampa-2)" />
      </svg>
      <span>{site.nome}</span>
    </a>

    <nav aria-label="Temas">
      <ul>
        {site.temas.map((t) =>
          t.ativo ? (
            <li><a href={`/${t.id}`} aria-current={t.id === temaAtual ? 'page' : undefined}>{t.nome}</a></li>
          ) : (
            <li><span class="em-breve" title="Em breve">{t.nome}</span></li>
          )
        )}
      </ul>
    </nav>

    <button id="botao-tema" class="botao-tema" type="button">Tema escuro</button>
  </div>
</header>

<script>
  // Troca entre tema claro e escuro e lembra a escolha.
  const botao = document.getElementById('botao-tema')!;
  const raiz = document.documentElement;
  const atualizarTexto = () => {
    const escuro = raiz.dataset.theme === 'dark';
    botao.textContent = escuro ? 'Tema claro' : 'Tema escuro';
    botao.setAttribute('aria-pressed', String(escuro));
  };
  atualizarTexto();
  botao.addEventListener('click', () => {
    const novo = raiz.dataset.theme === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = novo;
    try { localStorage.setItem('tema', novo); } catch {}
    atualizarTexto();
  });
</script>

<style>
  .cabecalho { border-bottom: 1px solid var(--line); background: var(--bg); }
  .barra { display: flex; align-items: center; gap: 48px; height: 84px; }
  .logo { display: flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  nav { flex: 1; min-width: 0; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 28px; }
  nav a, nav .em-breve { display: inline-block; padding: 28px 0 26px; font-size: 17px; text-decoration: none; border-bottom: 3px solid transparent; }
  nav a { color: var(--sub); }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--accent); }
  nav .em-breve { color: var(--faint); cursor: default; }
  .botao-tema { font: inherit; font-size: 15px; color: var(--ink); background: var(--bg); border: 1px solid var(--line2); border-radius: 8px; padding: 10px 16px; cursor: pointer; white-space: nowrap; }
  .botao-tema:hover { background: var(--surf); }
  .botao-tema:focus-visible, nav a:focus-visible, .logo:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 760px) {
    .barra { height: auto; flex-wrap: wrap; gap: 0 16px; padding-top: 12px; }
    .logo { flex: 1; }
    nav { order: 3; flex-basis: 100%; overflow-x: auto; }
    nav ul { gap: 20px; }
    nav a, nav .em-breve { padding: 14px 0 12px; font-size: 15px; }
    .botao-tema { padding: 8px 12px; font-size: 14px; }
  }
</style>
