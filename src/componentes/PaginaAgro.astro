---
// Página "Economia · Agro" de um país: produto líder (tudo / lavouras / pecuária) e quanto cada estado produz.
// Serve para qualquer país: tudo que muda vem do arquivo do país (src/config/paises/).
import Base from '../layouts/Base.astro';
import Abas from './Abas.astro';
import MapaRanking from './mapa-ranking/MapaRanking.astro';
import EspacoAnuncio from './EspacoAnuncio.astro';
import { construirVisaoLider, construirVisaoProduto, temCor, iconeDoProduto } from './mapa-ranking/construir-producao';
import { preencher } from './mapa-ranking/visao';
import site from '../config/site.json';
import { abasDe } from '../lib/catalogo';
import { contextoDoPais } from '../lib/contexto';
import { carregarAgro, temaAgro } from '../lib/agro';

interface Props { pais: any; teste?: boolean; temaId?: string }
const { pais, teste = false, temaId = 'agro' } = Astro.props;
const tema = temaAgro(pais, temaId);

const NIVEL = 'estado';
const { geo, ctx: ctxPais, unidades, mapa } = contextoDoPais(pais, NIVEL);
// Textos do molde ajustados ao tema (ex.: na indústria, "setor" no lugar de "produto").
const ctx = { ...ctxPais, textos: { ...ctxPais.textos, ...(tema.textosMolde ?? {}) } };
const { todos, porFiltro } = carregarAgro(pais, NIVEL, temaId);

const padrao = todos.find((p) => p.id === tema.produtoPadrao) ?? todos[0];
// Atalhos com ícone (como no design): os 6 produtos de maior valor que têm cor e ícone próprios.
const atalhos = new Set(todos.filter((p) => temCor(tema, p.id)).slice(0, 6).map((p) => p.id));
const visoes: Record<string, any> = {
  [`lista:${padrao.id}`]: construirVisaoProduto(padrao.id, unidades, porFiltro.tudo, padrao, 'valor', tema, ctx, true),
};
for (const f of tema.filtros) {
  visoes[`lider-${f.id}`] = construirVisaoLider(`lider-${f.id}`, unidades, porFiltro[f.id], tema, ctx, f.grupoTexto);
}
const opcoes = [
  {
    id: 'lider',
    rotulo: tema.opcoes.lider,
    filtros: { rotulo: tema.opcoes.mostrar, padrao: tema.filtros[0].id, itens: tema.filtros.map((f) => ({ id: f.id, rotulo: f.rotulo, visao: `lider-${f.id}` })) },
  },
  {
    id: 'quanto',
    rotulo: tema.opcoes.quanto,
    lista: {
      rotulo: ctx.textos.escolhaProduto,
      padrao: padrao.id,
      itens: Object.keys(tema.grupos).flatMap((g) =>
        todos.filter((p) => p.grupo === g).map((p) => ({
          id: p.id, rotulo: p.nome, grupo: tema.grupos[g as keyof typeof tema.grupos], url: preencher(tema.urlDadosProduto, { produto: p.id }),
          destaque: atalhos.has(p.id),
          iconeSvg: tema.icones.icones[iconeDoProduto(tema, p.id) as keyof typeof tema.icones.icones],
        }))
      ),
    },
  },
];

const vars = { pais: pais.nome, dePais: pais.dePais };
const titulo = preencher(tema.titulo, vars);
const trilha = tema.trilha.map((t) => preencher(t, vars));
// Abas de Economia (com grupos) vêm do cadastro; as que o país ainda não tem aparecem "em breve".
const abas = abasDe('economia', pais);
---
<Base titulo={`${trilha.at(-1)} · ${titulo}`} descricao={tema.descricao ? preencher(tema.descricao, { dePais: pais.dePais, pais: pais.nome }) : undefined} temaAtual="economia" naoIndexar={teste}>
  <section class="conteudo pagina">
    {teste && <p class="aviso-teste">Página de teste: ainda não aparece no menu do site.</p>}
    <p class="trilha">{trilha.join(' / ')}</p>
    <h1>{titulo}</h1>
    <Abas itens={abas} atual={temaId} rotulo="Economia" emBreve={site.textos.emBreve} />
    <MapaRanking geo={geo} mapa={mapa} ctx={ctx} opcoes={opcoes} opcaoInicial="lider" visoes={visoes} />
    <EspacoAnuncio posicao="abaixo-ranking" />
  </section>
</Base>

<style>
  .pagina { padding-top: 40px; padding-bottom: 80px; }
  .aviso-teste { display: inline-block; margin: 0 0 16px; padding: 6px 12px; font-size: 14px; color: var(--sub); background: var(--surf); border: 1px dashed var(--line2); border-radius: 8px; }
  .trilha { margin: 0 0 12px; color: var(--sub); font-size: 17px; }
  h1 { margin: 0 0 24px; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; }
</style>
